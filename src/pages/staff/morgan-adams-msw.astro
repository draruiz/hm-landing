---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../utils/seo";

const siteUrl = "https://healthymindspecialists.com";
const staffName = "Morgan Adams, MSW";
const staffRole = "Life & Mindfulness Coach";
const staffSlug = "morgan-adams-msw";
const tagline =
  "Helping you build confidence, clarity, and calm through mindfulness and personalized life strategies.";
const profileImage =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/b13d28c3-98c3-4dbd-7ba7-d16aefbad700/public";

const schemas = [
  breadcrumbSchema([
    { name: "Home", url: siteUrl },
    { name: "About Us", url: `${siteUrl}/about` },
    { name: staffName, url: `${siteUrl}/staff/${staffSlug}` },
  ]),
];
---

<Layout
  title={staffName}
  description={`Meet ${staffName}, ${staffRole} at Healthy Mind Specialists in Tampa, FL, and the guide behind Back to Calm. Certified in mindfulness, meditation, and sexual assault survivor support with a Master's in Social Work.`}
  schema={schemas}
  navOnLight
>
  <!-- Hero — warm, light, Back to Calm styling -->
  <section class='relative calm-gradient pt-36 pb-20 md:pt-44 md:pb-24 overflow-hidden'>
    <div
      class='absolute -top-40 -right-32 w-[520px] h-[520px] rounded-full bg-calm-lavender/80 blur-[130px] calm-float pointer-events-none'
      aria-hidden='true'
    >
    </div>
    <div
      class='absolute -bottom-44 -left-40 w-[480px] h-[480px] rounded-full bg-calm-blush/70 blur-[140px] calm-float-slow pointer-events-none'
      aria-hidden='true'
    >
    </div>

    <div
      class='relative max-w-6xl mx-auto px-6 sm:px-10 md:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center'
    >
      <div class='lg:col-span-7 order-2 lg:order-1'>
        <a
          href='/programs/back-to-calm'
          class='inline-flex items-center gap-2.5 rounded-full border border-brand-gold/30 bg-brand-white/60 px-4 py-1.5 font-mono text-[10px] tracking-[0.25em] uppercase text-brand-gold-dark mb-8 transition-colors duration-300 hover:bg-brand-white'
        >
          <span class='w-1.5 h-1.5 rounded-full bg-brand-gold' aria-hidden='true'
          ></span>
          Leads Back to Calm
        </a>
        <h1
          class='text-5xl sm:text-6xl md:text-7xl font-display font-semibold text-brand-charcoal leading-[0.95] tracking-[-0.015em]'
        >
          {staffName}
        </h1>
        <p
          class='mt-5 text-xl md:text-2xl font-display italic text-brand-gold-dark'
        >
          {staffRole}
        </p>
        <p
          class='mt-7 text-brand-charcoal/65 text-lg font-light leading-relaxed max-w-xl'
        >
          {tagline}
        </p>
      </div>

      <div class='lg:col-span-5 order-1 lg:order-2'>
        <div class='relative mx-auto max-w-xs sm:max-w-sm lg:max-w-none'>
          <div
            class='absolute -inset-3 rounded-t-[999px] rounded-b-[2.5rem] border border-brand-gold/25 pointer-events-none'
            aria-hidden='true'
          >
          </div>
          <div
            class='relative h-[360px] sm:h-[440px] lg:h-[480px] overflow-hidden rounded-t-[999px] rounded-b-[2.5rem] bg-calm-lavender'
          >
            <img
              src={profileImage}
              alt={`Portrait of ${staffName}, ${staffRole} at Healthy Mind Specialists`}
              width='800'
              height='1000'
              class='w-full h-full object-cover object-top'
              loading='eager'
              fetchpriority='high'
            />
            <div
              class='absolute inset-0 bg-gradient-to-br from-brand-gold/30 via-transparent to-calm-blush/40 mix-blend-soft-light pointer-events-none'
              aria-hidden='true'
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Back to Calm strip — her signature offering -->
  <section
    class='relative bg-brand-cream border-y border-brand-gold/15 overflow-hidden'
    aria-label='Back to Calm with Morgan'
  >
    <div
      class='relative max-w-5xl mx-auto px-6 py-14 md:py-16 flex flex-col md:flex-row md:items-center gap-8 md:gap-12'
    >
      <div class='flex-1'>
        <p
          class='text-3xl md:text-4xl font-display font-semibold text-brand-charcoal leading-tight'
        >
          <span
            class='script-cap text-[1.35em] text-brand-gold-dark mr-0.5'
            aria-hidden='true'>B</span
          ><span class='sr-only'>B</span>ack to <em
            class='not-italic text-brand-gold-dark'>Calm</em
          >
        </p>
        <p class='mt-4 text-brand-charcoal/65 text-base md:text-lg font-light leading-relaxed max-w-xl'>
          Morgan leads Back to Calm — a personalized 60-minute emotional support
          session for the days when everything feels heavier than it should.
          Not formal therapy. Just support, when you need it.
        </p>
        <p class='mt-4 font-mono text-[11px] tracking-[0.18em] uppercase text-brand-gold-dark'>
          60 min · $125 · Online or in person
        </p>
      </div>
      <a
        href='/programs/back-to-calm'
        class='group flex-shrink-0 inline-flex items-center gap-3 px-8 py-4 text-sm font-semibold tracking-[0.06em] uppercase bg-brand-gold-dark text-white rounded-full transition-all duration-400 hover:bg-brand-blue-light'
      >
        <span>Discover Back to Calm</span>
        <svg
          class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Main Content -->
  <section class='bg-brand-white py-20 md:py-28'>
    <div class='max-w-4xl mx-auto px-6'>
      <!-- Bio Content -->
      <span
        class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-6'
      >
        About Morgan
      </span>
      <div
        class='max-w-none text-brand-charcoal/70 text-lg font-light leading-relaxed space-y-7'
      >
        <p>
          Life can feel overwhelming, fast-paced, and emotionally heavy at
          times. When stress, uncertainty, or difficult experiences begin to
          take over, having the right support can make a meaningful difference.
          I'm Morgan Adams, a life and mindfulness coach, and my work centers on
          walking alongside you as you regain a sense of grounding, clarity, and
          confidence.
        </p>
        <p>
          My approach is personalized and practical. I incorporate mindfulness,
          meditation, and coping strategies tailored to your unique needs and
          life circumstances. Coaching offers a supportive space to slow down,
          gain perspective, and develop tools that help you navigate challenges
          with greater intention and self-trust. Whether you are feeling stuck,
          emotionally drained, or simply ready for a shift, our work together
          focuses on helping you move forward in a way that feels authentic and
          sustainable.
        </p>
        <p>
          I am certified to work with survivors of sexual assault and am deeply
          committed to supporting individuals through healing and personal
          growth. My professional background includes experience in schools,
          crisis centers, community-based mental health programs, and work with
          children who have special needs. These settings have shaped a
          compassionate, flexible, and client-centered approach rooted in
          respect, safety, and empowerment.
        </p>
        <p>
          My educational background includes a Bachelor's degree in Social Work
          from Southeastern University and a Master's degree in Social Work from
          the University of Central Florida. I also hold an Associate's degree
          in Theology and a certificate in American Sign Language, which
          supports meaningful connection with individuals from diverse
          backgrounds and lived experiences.
        </p>
        <p>
          Originally from Indiana, I moved to Florida at 15 and quickly knew it
          would become home. Outside of work, I enjoy fishing, reading, and
          spending time outdoors in the Florida sunshine.
        </p>
        <p>
          If you are ready to explore new ways of coping, reconnect with
          yourself, and create meaningful change, I would be honored to support
          you.
        </p>
      </div>

      <!-- CTA -->
      <div
        class='mt-16 flex flex-col sm:flex-row items-center justify-center gap-4'
      >
        <a
          href='/programs/back-to-calm'
          class='group inline-flex items-center gap-3 px-8 py-4 bg-brand-gold-dark text-white text-sm font-semibold tracking-[0.06em] uppercase rounded-full transition-all duration-400 hover:bg-brand-blue-light'
        >
          <span>Book a Back to Calm session</span>
          <svg
            class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
          </svg>
        </a>
        <a
          href='/contact'
          class='inline-flex items-center px-8 py-4 border border-brand-charcoal/20 text-brand-charcoal text-sm font-semibold tracking-[0.06em] uppercase rounded-full transition-all duration-400 hover:border-brand-gold-dark hover:text-brand-gold-dark'
        >
          Schedule a Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>
