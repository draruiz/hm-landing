---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema, personSchema } from "../../utils/seo";

const siteUrl = "https://www.healthymindspecialists.com";
const staffName = "Victoria Echeverry";
const staffRole = "Licensed Therapist";
const staffSlug = "victoria-echeverry";
const tagline =
  "Specializing in Relationships, Attachment Patterns, Self-Esteem, Anxiety, and Emotional Healing";
const profileImage =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/c1ad6134-e7f2-4c5c-6968-d22a20f6d000/public";

const helpAreas = [
  {
    title: "Complicated Relationships and Emotional Dependency",
    body: "She helps you understand anxious and avoidant attachment patterns, recognize emotionally draining relationships, break unhealthy cycles, and develop healthier, more secure connections.",
  },
  {
    title: "Breakups, Divorce, and Difficulty Letting Go",
    body: "She supports you through heartbreak, separation, fear of abandonment, and emotional dependency, helping you rebuild your emotional stability and regain confidence in yourself.",
  },
  {
    title: "Self-Esteem, Self-Worth, and Emotional Wounds",
    body: "She works with you to rebuild your self-image, address emotional wounds related to rejection and abandonment, challenge limiting beliefs, and rediscover your sense of self-worth.",
  },
  {
    title: "Boundaries and Family Relationships",
    body: "She helps you establish healthier boundaries, overcome guilt associated with saying no, stop taking responsibility for everyone else's emotions, and develop more balanced family relationships.",
  },
  {
    title: "Anxiety, Depression, and Emotional Exhaustion",
    body: "With extensive clinical experience supporting individuals struggling with persistent anxiety, depression, overthinking, emotional insecurity, and difficulties managing overwhelming emotions, she helps you develop practical strategies to regain emotional balance.",
  },
  {
    title: "Life Transitions and Personal Crises",
    body: "She provides compassionate guidance through unexpected life changes, loss, identity struggles, workplace challenges, major transitions, and periods of uncertainty when you feel disconnected from yourself.",
  },
];

const schemas = [
  personSchema({
    displayName: staffName,
    jobTitle: staffRole,
    url: `${siteUrl}/staff/${staffSlug}`,
    image: profileImage,
    siteUrl,
  }),
  breadcrumbSchema([
    { name: "Home", url: siteUrl },
    { name: "About Us", url: `${siteUrl}/about` },
    { name: staffName, url: `${siteUrl}/staff/${staffSlug}` },
  ]),
];
---

<Layout
  title={staffName}
  description={`Meet ${staffName}, ${staffRole} at Healthy Mind Specialists in Tampa, FL. Bilingual therapy in English and Spanish for relationships, attachment patterns, self-esteem, anxiety, and emotional healing.`}
  schema={schemas}
  navOnLight
>
  <!-- Hero -->
  <section class='relative calm-gradient pt-36 pb-20 md:pt-44 md:pb-24 overflow-hidden'>
    <div
      class='absolute -top-40 -right-32 w-[520px] h-[520px] rounded-full bg-calm-lavender/80 blur-[130px] calm-float pointer-events-none'
      aria-hidden='true'
    >
    </div>
    <div
      class='absolute -bottom-44 -left-40 w-[480px] h-[480px] rounded-full bg-calm-blush/70 blur-[140px] calm-float-slow pointer-events-none'
      aria-hidden='true'
    >
    </div>

    <div
      class='relative max-w-6xl mx-auto px-6 sm:px-10 md:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center'
    >
      <div class='lg:col-span-7 order-2 lg:order-1'>
        <span
          class='inline-flex items-center gap-2.5 rounded-full border border-brand-gold/30 bg-brand-white/60 px-4 py-1.5 font-mono text-[10px] tracking-[0.25em] uppercase text-brand-gold-dark mb-8'
        >
          <span class='w-1.5 h-1.5 rounded-full bg-brand-gold' aria-hidden='true'
          ></span>
          Therapy in English and Spanish
        </span>
        <h1
          class='text-5xl sm:text-6xl md:text-7xl font-display font-semibold text-brand-charcoal leading-[0.95] tracking-[-0.015em]'
        >
          {staffName}
        </h1>
        <p
          class='mt-5 text-xl md:text-2xl font-display italic text-brand-gold-dark'
        >
          {staffRole}
        </p>
        <p
          class='mt-7 text-brand-charcoal/65 text-lg font-light leading-relaxed max-w-xl'
        >
          {tagline}
        </p>
      </div>

      <div class='lg:col-span-5 order-1 lg:order-2'>
        <div class='relative mx-auto max-w-xs sm:max-w-sm lg:max-w-none'>
          <div
            class='absolute -inset-3 rounded-t-[999px] rounded-b-[2.5rem] border border-brand-gold/25 pointer-events-none'
            aria-hidden='true'
          >
          </div>
          <div
            class='relative h-[360px] sm:h-[440px] lg:h-[480px] overflow-hidden rounded-t-[999px] rounded-b-[2.5rem] bg-calm-lavender'
          >
            <img
              src={profileImage}
              alt={`Portrait of ${staffName}, ${staffRole} at Healthy Mind Specialists`}
              width='354'
              height='768'
              class='w-full h-full object-cover object-[center_25%]'
              loading='eager'
              fetchpriority='high'
            />
            <div
              class='absolute inset-0 bg-gradient-to-br from-brand-gold/30 via-transparent to-calm-blush/40 mix-blend-soft-light pointer-events-none'
              aria-hidden='true'
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class='bg-brand-white py-20 md:py-28'>
    <div class='max-w-4xl mx-auto px-6'>
      <!-- Bio Content -->
      <span
        class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-6'
      >
        About Victoria
      </span>
      <div
        class='max-w-none text-brand-charcoal/70 text-lg font-light leading-relaxed space-y-7'
      >
        <p>
          With an extensive clinical background and a wealth of experience
          helping individuals navigate emotionally challenging situations, she
          is known for her deeply compassionate, empathetic, and down-to-earth
          approach to therapy.
        </p>
        <p>
          She creates a safe, welcoming space where you can feel genuinely
          heard, understood, and supported without fear of judgment.
        </p>
        <p>
          Her extensive experience allows her to understand the complexity of
          human emotions, especially when you recognize that something in your
          life is hurting you but struggle to find the strength, clarity, or
          tools to make meaningful changes.
        </p>
      </div>

      <!-- How she can help -->
      <h2
        class='mt-20 font-display font-semibold text-3xl md:text-4xl text-brand-charcoal tracking-[-0.01em]'
      >
        How Can She Help You?
      </h2>
      <ul class='mt-8 divide-y divide-brand-charcoal/10 border-y border-brand-charcoal/10'>
        {
          helpAreas.map((area) => (
            <li class='py-7'>
              <h3 class='font-display text-xl md:text-2xl font-semibold text-brand-charcoal leading-snug'>
                {area.title}
              </h3>
              <p class='mt-2 text-brand-charcoal/70 text-lg font-light leading-relaxed'>
                {area.body}
              </p>
            </li>
          ))
        }
      </ul>

      <!-- Approach -->
      <h2
        class='mt-20 font-display font-semibold text-3xl md:text-4xl text-brand-charcoal tracking-[-0.01em]'
      >
        Her Therapeutic Approach
      </h2>
      <div
        class='mt-8 max-w-none text-brand-charcoal/70 text-lg font-light leading-relaxed space-y-7'
      >
        <p>
          Her approach combines genuine warmth, clinical expertise, emotional
          depth, and practical strategies that support meaningful, lasting
          change.
        </p>
        <p>
          Therapy with her goes beyond simply talking about what hurts. It is an
          opportunity to understand why certain experiences affect you so
          deeply, recognize the emotional patterns that keep you stuck, and
          develop healthier ways of relating to yourself and others.
        </p>
        <p>
          She integrates evidence-based therapeutic approaches, including
          Cognitive Behavioral Therapy (CBT), Emotionally Focused Therapy (EFT),
          mindfulness, and other individualized strategies to help you move
          forward with greater emotional awareness, confidence, and clarity.
        </p>
        <p>
          She is the kind of therapist who listens without judgment, understands
          your experiences without minimizing your pain, and helps you rebuild
          your emotional well-being with compassion, guidance, and genuine
          understanding.
        </p>
        <p class='font-display italic text-xl md:text-2xl text-brand-gold-dark leading-snug'>
          Therapy available in English and Spanish, with a culturally sensitive
          approach that honors each individual's unique background and
          experiences.
        </p>
      </div>

      <!-- CTA -->
      <div class='mt-16 text-center'>
        <a
          href='/contact'
          class='inline-flex items-center px-8 py-4 bg-brand-gold-dark text-white text-sm font-semibold tracking-[0.06em] uppercase rounded-full transition-all duration-400 hover:bg-brand-blue-light'
        >
          Schedule a Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>
