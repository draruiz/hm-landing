---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../utils/seo";

const siteUrl = "https://healthymindspecialists.com";
const staffName = "Traci Adams, CLC";
const staffRole = "Certified Life Coach";
const staffSlug = "traci-adams-clc";
const tagline =
  "Specializing in working with teens, young adults, and couples.";
const profileImage =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/96c2a220-7c97-4a54-5bed-de73b398c600/public";

const schemas = [
  breadcrumbSchema([
    { name: "Home", url: siteUrl },
    { name: "About Us", url: `${siteUrl}/about` },
    { name: staffName, url: `${siteUrl}/staff/${staffSlug}` },
  ]),
];
---

<Layout
  title={staffName}
  description={`Meet ${staffName}, ${staffRole} at Healthy Mind Specialists in Tampa, FL, and the coach behind Strong Mind Teens. Specializing in adolescent coaching, young adults, and couples with over 20 years of case management experience.`}
  schema={schemas}
  navOnLight
>
  <!-- Hero — warm, light, matching the Strong Mind Teens program -->
  <section class='relative calm-gradient pt-36 pb-20 md:pt-44 md:pb-24 overflow-hidden'>
    <div
      class='absolute -top-40 -right-32 w-[520px] h-[520px] rounded-full bg-calm-lavender/80 blur-[130px] calm-float pointer-events-none'
      aria-hidden='true'
    >
    </div>
    <div
      class='absolute -bottom-44 -left-40 w-[480px] h-[480px] rounded-full bg-calm-blush/70 blur-[140px] calm-float-slow pointer-events-none'
      aria-hidden='true'
    >
    </div>

    <div
      class='relative max-w-6xl mx-auto px-6 sm:px-10 md:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center'
    >
      <div class='lg:col-span-7 order-2 lg:order-1'>
        <a
          href='/programs/strong-mind-teens'
          class='inline-flex items-center gap-2.5 rounded-full border border-brand-gold/30 bg-brand-white/60 px-4 py-1.5 font-mono text-[10px] tracking-[0.25em] uppercase text-brand-gold-dark mb-8 transition-colors duration-300 hover:bg-brand-white'
        >
          <span class='w-1.5 h-1.5 rounded-full bg-brand-gold' aria-hidden='true'
          ></span>
          Coaches Strong Mind Teens
        </a>
        <h1
          class='text-5xl sm:text-6xl md:text-7xl font-display font-semibold text-brand-charcoal leading-[0.95] tracking-[-0.015em]'
        >
          {staffName}
        </h1>
        <p
          class='mt-5 text-xl md:text-2xl font-display italic text-brand-gold-dark'
        >
          {staffRole}
        </p>
        <p
          class='mt-7 text-brand-charcoal/65 text-lg font-light leading-relaxed max-w-xl'
        >
          {tagline}
        </p>
      </div>

      <div class='lg:col-span-5 order-1 lg:order-2'>
        <div class='relative mx-auto max-w-xs sm:max-w-sm lg:max-w-none'>
          <div
            class='absolute -inset-3 rounded-t-[999px] rounded-b-[2.5rem] border border-brand-gold/25 pointer-events-none'
            aria-hidden='true'
          >
          </div>
          <div
            class='relative h-[360px] sm:h-[440px] lg:h-[480px] overflow-hidden rounded-t-[999px] rounded-b-[2.5rem] bg-calm-lavender'
          >
            <img
              src={profileImage}
              alt={`Portrait of ${staffName}, ${staffRole} at Healthy Mind Specialists`}
              width='800'
              height='1000'
              class='w-full h-full object-cover object-top'
              loading='eager'
              fetchpriority='high'
            />
            <div
              class='absolute inset-0 bg-gradient-to-br from-brand-gold/30 via-transparent to-calm-blush/40 mix-blend-soft-light pointer-events-none'
              aria-hidden='true'
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Strong Mind Teens strip — her signature program -->
  <section
    class='relative bg-brand-cream border-y border-brand-gold/15 overflow-hidden'
    aria-label='Strong Mind Teens with Traci'
  >
    <div
      class='relative max-w-5xl mx-auto px-6 py-14 md:py-16 flex flex-col md:flex-row md:items-center gap-8 md:gap-12'
    >
      <div class='flex-1'>
        <p
          class='text-3xl md:text-4xl font-display font-semibold text-brand-charcoal leading-tight'
        >
          <span
            class='script-cap text-[1.35em] text-brand-gold-dark mr-0.5'
            aria-hidden='true'>S</span
          ><span class='sr-only'>S</span>trong Mind <em
            class='not-italic text-brand-gold-dark'>Teens</em
          >
        </p>
        <p
          class='mt-4 text-brand-charcoal/65 text-base md:text-lg font-light leading-relaxed max-w-xl'
        >
          Traci coaches Strong Mind Teens — a 6-week program built for the real
          struggles adolescents face today. Structured, practical, and adapted
          to their language. Not a space to simply talk: guided support with
          direction.
        </p>
        <p
          class='mt-4 font-mono text-[11px] tracking-[0.18em] uppercase text-brand-gold-dark'
        >
          6 weeks · $900 package · Parents included
        </p>
      </div>
      <a
        href='/programs/strong-mind-teens'
        class='group flex-shrink-0 inline-flex items-center gap-3 px-8 py-4 text-sm font-semibold tracking-[0.06em] uppercase bg-brand-gold-dark text-white rounded-full transition-all duration-400 hover:bg-brand-blue-light'
      >
        <span>Discover the program</span>
        <svg
          class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Main Content -->
  <section class='bg-brand-white py-20 md:py-28'>
    <div class='max-w-4xl mx-auto px-6'>
      <!-- Bio Content -->
      <span
        class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-6'
      >
        About Traci
      </span>
      <div
        class='max-w-none text-brand-charcoal/70 text-lg font-light leading-relaxed space-y-7'
      >
        <p>
          Life doesn't always follow a straight path, and sometimes, we need
          support to move forward with clarity and confidence.
        </p>
        <p>
          As a Certified Professional Life Coach at Healthy Mind Specialists, I
          work with teens, young adults, and couples who are navigating life
          transitions, relationship challenges, and high-stress environments. My
          goal is to create a safe, supportive space where you can feel
          empowered to grow, reconnect, and take meaningful steps toward lasting
          change.
        </p>
        <p>
          With over 20 years of experience as a case manager in a variety of
          settings, I bring practical insight, deep empathy, and a calm,
          grounded approach to every session. Coaching offers a forward-focused,
          collaborative process that helps you develop new strategies, improve
          communication, and move through stuck points, without requiring a
          clinical diagnosis or diving into past trauma.
        </p>
        <p>
          My work is informed by specialized training in Dialectical Behavior
          Therapy (DBT) for adolescents, trauma-informed communication, cultural
          connection in families, and adolescent development. I also have a
          passion for supporting parents and caregivers through difficult
          behavioral dynamics at home.
        </p>
        <p>
          Whether you are feeling overwhelmed, disconnected, or simply ready for
          something to shift, I offer tools and perspective that meet you where
          you are. Together, we can strengthen your sense of balance,
          resilience, and purpose, one step at a time.
        </p>
        <p>
          When I'm not coaching, you can find me enjoying the Florida sunshine,
          spending time with my grandchildren, Alice and Eli, and continuing my
          lifelong passion for mental wellness.
        </p>
        <p>
          If you're ready to explore what's next, I'd be honored to walk with
          you. Let's connect.
        </p>
      </div>

      <!-- CTA -->
      <div
        class='mt-16 flex flex-col sm:flex-row items-center justify-center gap-4'
      >
        <a
          href='/programs/strong-mind-teens'
          class='group inline-flex items-center gap-3 px-8 py-4 bg-brand-gold-dark text-white text-sm font-semibold tracking-[0.06em] uppercase rounded-full transition-all duration-400 hover:bg-brand-blue-light'
        >
          <span>Explore Strong Mind Teens</span>
          <svg
            class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
          </svg>
        </a>
        <a
          href='/contact'
          class='inline-flex items-center px-8 py-4 border border-brand-charcoal/20 text-brand-charcoal text-sm font-semibold tracking-[0.06em] uppercase rounded-full transition-all duration-400 hover:border-brand-gold-dark hover:text-brand-gold-dark'
        >
          Schedule a Consultation
        </a>
      </div>
    </div>
  </section>
</Layout>
