---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../utils/seo";

const siteUrl = "https://healthymindspecialists.com";
const pageUrl = `${siteUrl}/programs/strong-mind-teens`;

// Traci's own photo library (Cloudflare Images) — no stock needed on this page.
const traciPortrait =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/96c2a220-7c97-4a54-5bed-de73b398c600/public";
const traciSign =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/f6623768-e576-48e3-00be-f1f5e1c72600/public";
const traciWithTeenOutdoors =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/84d3593e-6c31-4ae5-1ca7-568eaab2bb00/public";
const traciWithFamily =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/05467d69-3383-4009-4125-1665dbd32c00/public";
const traciWithTeenIndoors =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/b394d150-b3c9-4f09-7ceb-8c15687c9a00/public";

const coreIssues = [
  "Constant anxiety with no clear explanation",
  "Difficulty regulating emotions and emotional outbursts",
  "Low self-esteem and chronic comparison",
  "Ongoing conflict with parents and feeling misunderstood",
  "Excessive phone use as emotional escape",
  "Lack of motivation, apathy, and loss of direction",
  "Social anxiety and fear of rejection",
  "Feeling emotionally alone, even within the family system",
];

const programSteps = [
  {
    step: "01",
    title: "Parent Consultation",
    subtitle: "Before you start",
    description:
      "The process begins with a parent consultation to determine whether the program is the right fit. Parents share concerns, ask questions, and gain clarity on how the program works before enrolling.",
  },
  {
    step: "02",
    title: "Intake & Goal Setting",
    subtitle: "Week 1",
    description:
      "The first session focuses on building rapport with the adolescent and understanding emotional stressors, daily routines, and communication patterns. Clear and realistic goals are established.",
  },
  {
    step: "03",
    title: "Weekly Coaching Sessions",
    subtitle: "Weeks 2–5",
    description:
      "Each week includes a 60-minute individual coaching session focused on emotional regulation, anxiety management, habit and routine development, communication skills, and accountability.",
  },
  {
    step: "04",
    title: "Parent Guidance & Check-Ins",
    subtitle: "Throughout",
    description:
      "Parents receive guidance on how to support changes at home, reinforce boundaries, and reduce conflict. This keeps everyone consistent and prevents mixed messages.",
  },
  {
    step: "05",
    title: "Progress Monitoring",
    subtitle: "Clinical awareness",
    description:
      "Progress is monitored throughout the six weeks. The program operates within a clinically informed framework supported by Healthy Mind Specialists, ensuring responsible oversight.",
  },
  {
    step: "06",
    title: "Wrap-Up & Next Steps",
    subtitle: "Week 6",
    description:
      "The final session reviews progress, reinforces skills, and creates a forward plan. Parents receive feedback and guidance on sustaining improvements or exploring next steps if needed.",
  },
];

const outcomes = [
  {
    title: "Understand what they are feeling",
    description:
      "Identify what they feel and why they react the way they do, and recognize their own emotional patterns and triggers.",
  },
  {
    title: "Learn emotional regulation",
    description:
      "Regulate emotions without suppressing them, with practical tools for everyday emotional management.",
  },
  {
    title: "Develop internal security",
    description:
      "Build internal security and personal judgment, strengthening self-confidence and decision-making.",
  },
  {
    title: "Improve communication",
    description:
      "Communicate with parents without constant confrontation, and express needs and emotions effectively.",
  },
  {
    title: "Reduce anxiety",
    description:
      "Reduce anxiety and emotional dependence on their phone by developing healthier coping mechanisms.",
  },
  {
    title: "Rebuild motivation",
    description:
      "Rebuild motivation and personal meaning, and find direction and purpose again.",
  },
];

const forParents = [
  "Improved communication at home",
  "Increased emotional regulation",
  "Better school performance and organization",
  "Healthier friendships and boundaries",
  "More confidence and responsibility",
];

const forTeens = [
  "Feeling understood and supported",
  "Practical tools for everyday challenges",
  "Reduced anxiety",
  "More motivation and clarity",
  "A stronger sense of identity and self-worth",
];

const whyTraci = [
  {
    title: "Specialized adolescent focus",
    description:
      "Expert in parent-teen communication, conflict reduction, and establishing healthy habits and routines — sleep, school, organization, boundaries.",
  },
  {
    title: "Clinically supported model",
    description:
      "Her work is supported by licensed mental health professionals and aligned with ethical, evidence-based standards.",
  },
  {
    title: "Integrated care advantage",
    description:
      "If deeper clinical support is needed, the clinic has resources for psychological evaluation and coordinated care — ensuring continuity and early identification of concerns.",
  },
  {
    title: "Emotional regulation & anxiety support",
    description:
      "Specialized in emotional regulation, anxiety-related behaviors, stress management, transitions, and family dynamic challenges.",
  },
];

const schemas = [
  breadcrumbSchema([
    { name: "Home", url: siteUrl },
    { name: "Programs", url: pageUrl },
    { name: "Strong Mind Teens", url: pageUrl },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Strong Mind Teens — Adolescent Coaching Program",
    serviceType: "Adolescent coaching program",
    description:
      "A 6-week adolescent coaching program with Traci Adams, CLC, at Healthy Mind Specialists. Structured, practical coaching for teens struggling with anxiety, emotional regulation, motivation, and family communication.",
    url: pageUrl,
    provider: {
      "@type": "MedicalBusiness",
      name: "Healthy Mind Specialists",
      url: siteUrl,
      telephone: "813-609-2034",
    },
    areaServed: { "@type": "State", name: "Florida" },
    offers: [
      {
        "@type": "Offer",
        name: "Single session",
        price: "175",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
      {
        "@type": "Offer",
        name: "6-week program package",
        price: "900",
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
      },
    ],
  },
];
---

<Layout
  title='Strong Mind Teens — 6-Week Adolescent Coaching Program'
  description='A 6-week adolescent coaching program with Traci Adams, CLC, at Healthy Mind Specialists. Structured, practical coaching for teens facing anxiety, emotional regulation, motivation, and family communication challenges.'
  schema={schemas}
  navOnLight
>
  <!-- ============================ HERO ============================ -->
  <section
    class='relative calm-gradient pt-36 pb-24 md:pt-48 md:pb-32 overflow-hidden'
    aria-label='Strong Mind Teens'
  >
    <div
      class='absolute -top-40 -right-32 w-[560px] h-[560px] rounded-full bg-calm-lavender/80 blur-[130px] calm-float pointer-events-none'
      aria-hidden='true'
    >
    </div>
    <div
      class='absolute -bottom-48 -left-40 w-[520px] h-[520px] rounded-full bg-calm-blush/70 blur-[140px] calm-float-slow pointer-events-none'
      aria-hidden='true'
    >
    </div>

    <div
      class='relative max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 items-center'
    >
      <div class='lg:col-span-7'>
        <span
          class='inline-flex items-center gap-2.5 rounded-full border border-brand-gold/30 bg-brand-white/60 px-4 py-1.5 font-mono text-[10px] tracking-[0.25em] uppercase text-brand-gold-dark mb-8'
        >
          <span class='w-1.5 h-1.5 rounded-full bg-brand-gold' aria-hidden='true'
          ></span>
          6-Week Coaching Program
        </span>

        <h1
          class='text-5xl sm:text-6xl md:text-7xl font-display font-semibold text-brand-charcoal leading-[0.95] tracking-[-0.015em]'
        >
          <span
            class='script-cap text-[1.3em] text-brand-gold-dark mr-0.5'
            aria-hidden='true'>S</span
          ><span class='sr-only'>S</span>trong Mind <em
            class='not-italic text-brand-gold-dark'>Teens</em
          >
        </h1>

        <p
          class='mt-8 text-2xl md:text-3xl font-display italic text-brand-charcoal/75 leading-snug max-w-2xl'
        >
          Not a space to simply talk — guided support with direction.
        </p>

        <p
          class='mt-7 text-brand-charcoal/60 text-lg font-light leading-relaxed max-w-xl'
        >
          A coaching program built for the real struggles adolescents face
          today: structured, practical, and adapted to their language and
          emotional stage. Six weeks of individual sessions, with parents guided
          the whole way.
        </p>

        <div class='mt-10 flex flex-wrap items-center gap-3'>
          {
            ["6 weeks", "60-minute sessions", "Parents included"].map((meta) => (
              <span class='rounded-full border border-brand-charcoal/12 bg-brand-white/70 px-5 py-2.5 text-[13px] font-medium text-brand-charcoal/75'>
                {meta}
              </span>
            ))
          }
        </div>

        <a
          href='/staff/traci-adams-clc'
          class='group mt-9 inline-flex items-center gap-4 rounded-full bg-brand-white/70 border border-brand-gold/15 py-2 pl-2 pr-6 transition-colors duration-300 hover:bg-brand-white'
        >
          <img
            src={traciPortrait}
            alt='Traci Adams, CLC'
            width='96'
            height='96'
            class='w-12 h-12 rounded-full object-cover object-top'
            loading='lazy'
          />
          <span class='flex flex-col leading-tight'>
            <span class='text-[15px] font-semibold text-brand-charcoal'>
              Coached by Traci Adams, CLC
            </span>
            <span
              class='text-[12px] text-brand-charcoal/50 group-hover:text-brand-gold-dark transition-colors duration-300'
            >
              Certified Life Coach — meet Traci
            </span>
          </span>
        </a>

        <div
          class='mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-4'
        >
          <a
            href='tel:8136092034'
            class='group inline-flex items-center gap-3 px-8 py-4 text-sm font-semibold tracking-[0.06em] uppercase bg-brand-gold-dark text-white rounded-full transition-all duration-400 hover:bg-brand-blue-light'
          >
            <span>Start with a parent consultation</span>
            <svg
              class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              stroke-width='2'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
            </svg>
          </a>
          <a
            href='#investment'
            class='inline-flex items-center gap-2 px-8 py-4 text-sm font-semibold tracking-[0.06em] uppercase border border-brand-charcoal/20 text-brand-charcoal rounded-full transition-all duration-400 hover:border-brand-gold-dark hover:text-brand-gold-dark'
          >
            See the investment
          </a>
        </div>
      </div>

      <!-- Hero image — arch -->
      <div class='lg:col-span-5'>
        <div class='relative mx-auto max-w-md lg:max-w-none'>
          <div
            class='absolute -inset-3 rounded-t-[999px] rounded-b-[2.5rem] border border-brand-gold/25 pointer-events-none'
            aria-hidden='true'
          >
          </div>
          <div
            class='relative h-[420px] sm:h-[520px] lg:h-[600px] overflow-hidden rounded-t-[999px] rounded-b-[2.5rem] bg-calm-lavender'
          >
            <img
              src={traciSign}
              alt='Traci Adams, Certified Life Coach, beside a sign reading emotional regulation and communication skills'
              width='1000'
              height='1200'
              class='w-full h-full object-cover'
              loading='eager'
              fetchpriority='high'
            />
            <div
              class='absolute inset-0 bg-gradient-to-br from-brand-gold/30 via-transparent to-calm-blush/40 mix-blend-soft-light pointer-events-none'
              aria-hidden='true'
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CORE ISSUES ==================== -->
  <section class='relative bg-brand-white py-24 md:py-32' aria-label='Core issues'>
    <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
      <div class='max-w-2xl mb-16' data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-5'
        >
          What we see
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.05] tracking-[-0.01em]'
        >
          What teens live with<br />
          <em class='not-italic text-brand-gold-dark'
            >and don't know how to say.</em
          >
        </h2>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-0'>
        {
          coreIssues.map((issue, i) => (
            <div
              class='flex items-baseline gap-5 py-5 border-b border-brand-charcoal/8'
              data-animate
            >
              <span class='font-mono text-[10px] tracking-[0.25em] text-brand-gold-dark/60 flex-shrink-0'>
                {String(i + 1).padStart(2, "0")}
              </span>
              <p class='text-brand-charcoal/75 text-lg font-light leading-relaxed'>
                {issue}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== OUTCOMES ==================== -->
  <section class='relative bg-brand-cream py-24 md:py-32' aria-label='Outcomes'>
    <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
      <div class='max-w-2xl mb-16 md:mb-20' data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-5'
        >
          What changes
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.05] tracking-[-0.01em]'
        >
          What the program helps them do
        </h2>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6'>
        {
          outcomes.map((outcome, i) => (
            <div
              class='group rounded-[1.75rem] bg-brand-white border border-brand-charcoal/6 p-8 transition-all duration-500 hover:border-brand-gold/40 hover:shadow-[0_20px_50px_-30px_rgba(36,30,78,0.45)]'
              data-animate
            >
              <span class='block font-mono text-[10px] tracking-[0.3em] text-brand-gold-dark/60 mb-5'>
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class='text-xl md:text-2xl font-display font-semibold text-brand-charcoal leading-snug mb-3'>
                {outcome.title}
              </h3>
              <p class='text-brand-charcoal/55 text-[15px] font-light leading-relaxed'>
                {outcome.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== HOW IT WORKS ==================== -->
  <section class='relative bg-brand-white py-24 md:py-32' aria-label='How it works'>
    <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
      <div class='max-w-2xl mb-16 md:mb-20' data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-5'
        >
          The six weeks
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.05] tracking-[-0.01em]'
        >
          How the program works
        </h2>
        <p class='mt-7 text-brand-charcoal/60 text-lg font-light leading-relaxed'>
          A step-by-step structure designed to create change that outlasts the
          six weeks — for the teen and for the household.
        </p>
      </div>

      <div class='grid grid-cols-1 lg:grid-cols-12 gap-14'>
        <ol class='lg:col-span-7 space-y-0'>
          {
            programSteps.map((step) => (
              <li
                class='flex gap-6 md:gap-8 py-8 border-b border-brand-charcoal/8 last:border-0'
                data-animate
              >
                <span class='flex-shrink-0 w-12 h-12 rounded-full border border-brand-gold/35 bg-calm-lavender/60 text-brand-gold-dark flex items-center justify-center font-mono text-[13px]'>
                  {step.step}
                </span>
                <div class='flex-1'>
                  <span class='block font-mono text-[10px] tracking-[0.25em] uppercase text-brand-gold-dark/70 mb-2'>
                    {step.subtitle}
                  </span>
                  <h3 class='text-2xl md:text-3xl font-display font-semibold text-brand-charcoal leading-snug mb-3'>
                    {step.title}
                  </h3>
                  <p class='text-brand-charcoal/60 text-[15px] md:text-base font-light leading-relaxed'>
                    {step.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class='lg:col-span-5' data-animate>
          <div class='lg:sticky lg:top-32 space-y-5'>
            <div class='relative overflow-hidden rounded-[2rem] h-[320px] sm:h-[420px] bg-calm-lavender'>
              <img
                src={traciWithTeenIndoors}
                alt='Traci Adams in a coaching session with a teenager at Healthy Mind Specialists'
                width='800'
                height='900'
                class='w-full h-full object-cover'
                loading='lazy'
              />
              <div
                class='absolute inset-0 bg-gradient-to-br from-brand-gold/30 via-transparent to-calm-blush/40 mix-blend-soft-light pointer-events-none'
                aria-hidden='true'
              >
              </div>
            </div>
            <blockquote
              class='rounded-[2rem] bg-calm-lavender/60 border border-brand-gold/15 p-8'
            >
              <p
                class='text-xl md:text-2xl font-display italic font-light text-brand-charcoal/80 leading-snug'
              >
                "Not every adolescent needs therapy. But no adolescent should be
                guided without clinical awareness."
              </p>
              <footer
                class='mt-5 font-mono text-[10px] tracking-[0.25em] uppercase text-brand-gold-dark'
              >
                Traci's philosophy
              </footer>
            </blockquote>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== WHAT TO EXPECT ==================== -->
  <section class='relative bg-brand-cream py-24 md:py-32' aria-label='What to expect'>
    <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
      <div class='max-w-2xl mb-16' data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-5'
        >
          What to expect
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.05] tracking-[-0.01em]'
        >
          Two people leave changed.
        </h2>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8'>
        <div
          class='rounded-[2rem] bg-calm-lavender/60 border border-brand-gold/15 p-9 md:p-11'
          data-animate
        >
          <h3
            class='text-2xl md:text-3xl font-display font-semibold text-brand-charcoal mb-7'
          >
            For parents
          </h3>
          <ul class='space-y-4'>
            {
              forParents.map((item) => (
                <li class='flex items-start gap-4'>
                  <span
                    class='mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-brand-gold-dark/12 flex items-center justify-center'
                    aria-hidden='true'
                  >
                    <svg
                      class='w-3 h-3 text-brand-gold-dark'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke='currentColor'
                      stroke-width='3'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        d='M5 13l4 4L19 7'
                      />
                    </svg>
                  </span>
                  <span class='text-brand-charcoal/75 leading-relaxed'>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class='rounded-[2rem] bg-calm-blush/50 border border-brand-teal/25 p-9 md:p-11'
          data-animate
        >
          <h3
            class='text-2xl md:text-3xl font-display font-semibold text-brand-charcoal mb-7'
          >
            For teens
          </h3>
          <ul class='space-y-4'>
            {
              forTeens.map((item) => (
                <li class='flex items-start gap-4'>
                  <span
                    class='mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-brand-charcoal/8 flex items-center justify-center'
                    aria-hidden='true'
                  >
                    <svg
                      class='w-3 h-3 text-brand-charcoal/55'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke='currentColor'
                      stroke-width='3'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        d='M5 13l4 4L19 7'
                      />
                    </svg>
                  </span>
                  <span class='text-brand-charcoal/75 leading-relaxed'>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== WHY TRACI (dark band) ==================== -->
  <section
    class='relative dark-gradient text-brand-white py-24 md:py-36 overflow-hidden'
    aria-label='Why Traci'
  >
    <div
      class='absolute -top-32 left-1/4 w-[560px] h-[560px] rounded-full bg-brand-gold/6 blur-[180px] pointer-events-none'
      aria-hidden='true'
    >
    </div>

    <div class='relative max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
      <div class='max-w-2xl mb-16 md:mb-20' data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-gold block mb-5'
        >
          Why Traci
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold leading-[1.05] tracking-[-0.01em]'
        >
          Coaching with clinical awareness
        </h2>
        <p class='mt-7 text-brand-white/60 text-lg font-light leading-relaxed'>
          Traci brings over 20 years of case management experience and
          specialized training in DBT for adolescents, trauma-informed
          communication, and adolescent development.
        </p>
      </div>

      <div
        class='grid grid-cols-1 sm:grid-cols-2 gap-y-12 gap-x-10 lg:gap-x-16 border-t border-brand-white/10 pt-14'
      >
        {
          whyTraci.map((reason) => (
            <div data-animate>
              <h3 class='text-2xl md:text-3xl font-display font-semibold text-brand-gold leading-snug mb-4'>
                {reason.title}
              </h3>
              <p class='text-brand-white/55 text-[15px] font-light leading-relaxed'>
                {reason.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== MEET TRACI ==================== -->
  <section class='relative bg-brand-white py-24 md:py-32' aria-label='Meet Traci'>
    <div
      class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 items-center'
    >
      <div class='lg:col-span-5' data-animate>
        <div class='relative mx-auto max-w-sm lg:max-w-none'>
          <div
            class='absolute -inset-3 rounded-[2.5rem] border border-brand-gold/25 pointer-events-none'
            aria-hidden='true'
          >
          </div>
          <div
