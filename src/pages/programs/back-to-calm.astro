---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema } from "../../utils/seo";

const siteUrl = "https://healthymindspecialists.com";
const pageUrl = `${siteUrl}/programs/back-to-calm`;

const morganImage =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/b13d28c3-98c3-4dbd-7ba7-d16aefbad700/public";

const helpMoments = [
  {
    title: "When anxiety or panic feels difficult to manage",
    description:
      "Your body is on alert and you need someone to help you slow it down.",
  },
  {
    title: "When overthinking keeps you stuck",
    description:
      "The same thought loops all day and you can't find the way out on your own.",
  },
  {
    title: "When you're facing an important decision",
    description:
      "You need space to think out loud with someone who isn't inside the situation.",
  },
  {
    title: "When life feels emotionally exhausting",
    description:
      "You're carrying more than usual and it's starting to weigh on everything.",
  },
  {
    title: "When you feel alone and need someone in your corner",
    description:
      "Not advice from everyone around you — just one person fully on your side.",
  },
  {
    title: "When you simply need support getting through a difficult day",
    description:
      "No diagnosis needed. Some days are just hard, and that's reason enough.",
  },
];

const afterFeelings = [
  { word: "Lighter", detail: "As if a weight has been lifted." },
  { word: "Relief", detail: "The pressure finally eases." },
  { word: "Clarity", detail: "What felt tangled starts to make sense." },
  { word: "Reassured", detail: "You're not overreacting, and you're not alone." },
];

const whatItIs = [
  "A supportive, flexible space where you can talk openly",
  "Time to feel heard without explaining yourself twice",
  "Practical guidance you can actually use today",
  "Clarity when you need it most",
];

const whatItIsNot = [
  "Not formal therapy or a clinical treatment plan",
  "No diagnosis, no intake paperwork marathon",
  "No commitment to a long program",
  "No waiting weeks to be seen",
];

const schemas = [
  breadcrumbSchema([
    { name: "Home", url: siteUrl },
    { name: "Programs", url: `${siteUrl}/programs/back-to-calm` },
    { name: "Back to Calm", url: pageUrl },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Back to Calm — Emotional Support Session",
    serviceType: "Emotional support session",
    description:
      "A personalized, 60-minute emotional support session with Morgan Adams, MSW, designed to help you navigate difficult moments, quiet overwhelming thoughts, and reconnect with a sense of calm. Available online or in person.",
    url: pageUrl,
    provider: {
      "@type": "MedicalBusiness",
      name: "Healthy Mind Specialists",
      url: siteUrl,
      telephone: "813-609-2034",
    },
    areaServed: { "@type": "State", name: "Florida" },
    offers: {
      "@type": "Offer",
      price: "125",
      priceCurrency: "USD",
      url: `${siteUrl}/get-started/appointment-request`,
      availability: "https://schema.org/InStock",
    },
  },
];
---

<Layout
  title='Back to Calm — 60-Minute Emotional Support Sessions'
  description='When life feels overwhelming, find your way back to calm. A personalized 60-minute emotional support session with Morgan Adams, MSW. $125, online or in person, at Healthy Mind Specialists.'
  schema={schemas}
  navOnLight
>
  <!-- ============================ HERO ============================ -->
  <section
    class='relative calm-gradient pt-36 pb-24 md:pt-48 md:pb-32 overflow-hidden'
    aria-label='Back to Calm'
  >
    <div
      class='absolute -top-40 -right-32 w-[560px] h-[560px] rounded-full bg-calm-lavender/80 blur-[130px] calm-float pointer-events-none'
      aria-hidden='true'
    >
    </div>
    <div
      class='absolute -bottom-48 -left-40 w-[520px] h-[520px] rounded-full bg-calm-blush/70 blur-[140px] calm-float-slow pointer-events-none'
      aria-hidden='true'
    >
    </div>

    <div
      class='relative max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 items-center'
    >
      <div class='lg:col-span-7'>
        <span
          class='inline-flex items-center gap-2.5 rounded-full border border-brand-gold/30 bg-brand-white/60 px-4 py-1.5 font-mono text-[10px] tracking-[0.25em] uppercase text-brand-gold-dark mb-8'
        >
          <span class='w-1.5 h-1.5 rounded-full bg-brand-gold' aria-hidden='true'
          ></span>
          Emotional Support Session
        </span>

        <h1
          class='text-6xl sm:text-7xl md:text-8xl font-display font-semibold text-brand-charcoal leading-[0.92] tracking-[-0.015em]'
        >
          <span
            class='script-cap text-[1.3em] text-brand-gold-dark mr-0.5'
            aria-hidden='true'>B</span
          ><span class='sr-only'>B</span>ack to <em
            class='not-italic text-brand-gold-dark'>Calm</em
          >
        </h1>

        <p
          class='mt-8 text-2xl md:text-3xl font-display italic text-brand-charcoal/75 leading-snug max-w-2xl'
        >
          When life feels overwhelming, find your way back to calm.
        </p>

        <p
          class='mt-7 text-brand-charcoal/60 text-lg font-light leading-relaxed max-w-xl'
        >
          Some days, your thoughts won't slow down. Anxiety takes over,
          decisions feel impossible, and everything seems heavier than it should
          be. You don't have to face those moments alone.
        </p>

        <!-- Meta -->
        <div class='mt-10 flex flex-wrap items-center gap-3'>
          {
            ["60 minutes", "$125 per session", "Online or in person"].map(
              (meta) => (
                <span class='rounded-full border border-brand-charcoal/12 bg-brand-white/70 px-5 py-2.5 text-[13px] font-medium text-brand-charcoal/75'>
                  {meta}
                </span>
              ),
            )
          }
        </div>

        <div
          class='mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-4'
        >
          <a
            href='/get-started/appointment-request'
            class='group inline-flex items-center gap-3 px-8 py-4 text-sm font-semibold tracking-[0.06em] uppercase bg-brand-gold-dark text-white rounded-full transition-all duration-400 hover:bg-brand-blue-light'
          >
            <span>Book your Back to Calm session</span>
            <svg
              class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              stroke-width='2'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
            </svg>
          </a>
          <a
            href='tel:8136092034'
            class='inline-flex items-center gap-2 px-8 py-4 text-sm font-semibold tracking-[0.06em] uppercase border border-brand-charcoal/20 text-brand-charcoal rounded-full transition-all duration-400 hover:border-brand-gold-dark hover:text-brand-gold-dark'
          >
            Call 813-609-2034
          </a>
        </div>
      </div>

      <!-- Hero image — arch -->
      <div class='lg:col-span-5'>
        <div class='relative mx-auto max-w-md lg:max-w-none'>
          <div
            class='absolute -inset-3 rounded-t-[999px] rounded-b-[2.5rem] border border-brand-gold/25 pointer-events-none'
            aria-hidden='true'
          >
          </div>
          <div
            class='relative h-[420px] sm:h-[520px] lg:h-[600px] overflow-hidden rounded-t-[999px] rounded-b-[2.5rem] bg-calm-lavender'
          >
            <img
              src='https://images.unsplash.com/photo-1552196563-55cd4e45efb3?w=1000&q=80'
              alt='Woman sitting calmly in a quiet, light-filled room, taking a moment to breathe'
              width='1000'
              height='1200'
              class='w-full h-full object-cover'
              loading='eager'
              fetchpriority='high'
            />
            <!-- Warm lavender grade so stock photography sits inside the palette -->
            <div
              class='absolute inset-0 bg-gradient-to-br from-brand-gold/35 via-transparent to-calm-blush/45 mix-blend-soft-light pointer-events-none'
              aria-hidden='true'
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== WHAT IT IS / ISN'T ==================== -->
  <section class='relative bg-brand-white py-24 md:py-32' aria-label='What it is'>
    <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
      <div class='max-w-3xl mb-16' data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-5'
        >
          What this is
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.05] tracking-[-0.01em]'
        >
          Not therapy.<br />
          <em class='not-italic text-brand-gold-dark'>Support, when you need it.</em>
        </h2>
        <p
          class='mt-7 text-brand-charcoal/60 text-lg font-light leading-relaxed'
        >
          Back to Calm is a personalized, 60-minute emotional support session
          with Morgan. It's a supportive, flexible space where you can talk
          openly, feel heard, receive practical guidance, and find clarity when
          you need it most.
        </p>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8'>
        <div
          class='rounded-[2rem] bg-calm-lavender/60 border border-brand-gold/15 p-9 md:p-11'
          data-animate
        >
          <h3
            class='text-2xl md:text-3xl font-display font-semibold text-brand-charcoal mb-7'
          >
            What you get
          </h3>
          <ul class='space-y-4'>
            {
              whatItIs.map((item) => (
                <li class='flex items-start gap-4'>
                  <span
                    class='mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-brand-gold-dark/12 flex items-center justify-center'
                    aria-hidden='true'
                  >
                    <svg
                      class='w-3 h-3 text-brand-gold-dark'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke='currentColor'
                      stroke-width='3'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        d='M5 13l4 4L19 7'
                      />
                    </svg>
                  </span>
                  <span class='text-brand-charcoal/75 leading-relaxed'>
                    {item}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class='rounded-[2rem] bg-calm-blush/50 border border-brand-teal/25 p-9 md:p-11'
          data-animate
        >
          <h3
            class='text-2xl md:text-3xl font-display font-semibold text-brand-charcoal mb-7'
          >
            What it isn't
          </h3>
          <ul class='space-y-4'>
            {
              whatItIsNot.map((item) => (
                <li class='flex items-start gap-4'>
                  <span
                    class='mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-brand-charcoal/8 flex items-center justify-center'
                    aria-hidden='true'
                  >
                    <span class='block w-2 h-[2px] rounded-full bg-brand-charcoal/45' />
                  </span>
                  <span class='text-brand-charcoal/70 leading-relaxed'>
                    {item}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== WHEN IT HELPS ==================== -->
  <section class='relative bg-brand-cream py-24 md:py-32' aria-label='When it helps'>
    <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
      <div class='max-w-2xl mb-16 md:mb-20' data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-5'
        >
          When to reach out
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.05] tracking-[-0.01em]'
        >
          When can Back to Calm help?
        </h2>
      </div>

      <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6'>
        {
          helpMoments.map((moment, i) => (
            <div
              class='group rounded-[1.75rem] bg-brand-white border border-brand-charcoal/6 p-8 transition-all duration-500 hover:border-brand-gold/40 hover:shadow-[0_20px_50px_-30px_rgba(36,30,78,0.45)]'
              data-animate
            >
              <span class='block font-mono text-[10px] tracking-[0.3em] text-brand-gold-dark/60 mb-5'>
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class='text-xl md:text-2xl font-display font-semibold text-brand-charcoal leading-snug mb-3'>
                {moment.title}
              </h3>
              <p class='text-brand-charcoal/55 text-[15px] font-light leading-relaxed'>
                {moment.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== HOW YOU MAY FEEL ==================== -->
  <section
    class='relative dark-gradient text-brand-white py-24 md:py-36 overflow-hidden'
    aria-label='After your session'
  >
    <div
      class='absolute -top-32 left-1/4 w-[560px] h-[560px] rounded-full bg-brand-gold/6 blur-[180px] pointer-events-none'
      aria-hidden='true'
    >
    </div>

    <div class='relative max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
      <div class='max-w-2xl mb-16 md:mb-20' data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-gold block mb-5'
        >
          After the session
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold leading-[1.05] tracking-[-0.01em]'
        >
          How you may feel afterward
        </h2>
        <p class='mt-7 text-brand-white/60 text-lg font-light leading-relaxed'>
          Many people describe feeling lighter afterward, as if a weight has
          been lifted from their shoulders.
        </p>
      </div>

      <div
        class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-12 gap-x-8 border-t border-brand-white/10 pt-14'
      >
        {
          afterFeelings.map((feeling) => (
            <div data-animate>
              <span class='block text-4xl md:text-5xl font-display font-semibold text-brand-gold leading-none'>
                {feeling.word}
              </span>
              <span class='block mt-4 text-brand-white/50 text-[15px] font-light leading-relaxed'>
                {feeling.detail}
              </span>
            </div>
          ))
        }
      </div>

      <blockquote
        class='mt-20 md:mt-24 max-w-3xl border-l-2 border-brand-gold/45 pl-7'
        data-animate
      >
        <p
          class='text-2xl md:text-3xl font-display italic font-light text-brand-white/80 leading-snug'
        >
          "At Healthy Mind, we created Back to Calm because we saw how effective
          this type of personalized support can be — and how often people need
          someone by their side during life's most challenging moments."
        </p>
      </blockquote>
    </div>
  </section>

  <!-- ==================== MEET MORGAN ==================== -->
  <section class='relative bg-brand-white py-24 md:py-32' aria-label='Meet Morgan'>
    <div
      class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 items-center'
    >
      <div class='lg:col-span-5' data-animate>
        <div class='relative mx-auto max-w-sm lg:max-w-none'>
          <div
            class='absolute -inset-3 rounded-[2.5rem] border border-brand-gold/25 pointer-events-none'
            aria-hidden='true'
          >
          </div>
          <div
            class='relative h-[420px] sm:h-[500px] overflow-hidden rounded-[2.5rem] bg-calm-lavender'
          >
            <img
              src={morganImage}
              alt='Morgan Adams, MSW — Life and Mindfulness Coach at Healthy Mind Specialists'
              width='800'
              height='1000'
              class='w-full h-full object-cover object-top'
              loading='lazy'
            />
          </div>
        </div>
      </div>

      <div class='lg:col-span-7' data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-5'
        >
          Your guide
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.05] tracking-[-0.01em]'
        >
          Meet Morgan Adams,
          <span class='text-brand-gold-dark'>MSW</span>
        </h2>
        <p
          class='mt-6 text-xl md:text-2xl font-display italic text-brand-charcoal/70 leading-snug max-w-xl'
        >
          Helping you build confidence, clarity, and calm through mindfulness
          and personalized life strategies.
        </p>
        <p
          class='mt-7 text-brand-charcoal/60 text-lg font-light leading-relaxed max-w-xl'
        >
          Morgan is a life and mindfulness coach with a Master's degree in
          Social Work from the University of Central Florida. Her background
          spans schools, crisis centers, and community-based mental health
          programs, and she is certified to work with survivors of sexual
          assault. Her approach is personalized and practical — mindfulness,
          meditation, and coping strategies shaped around your life, not a
          template.
        </p>
        <p
          class='mt-5 text-brand-charcoal/60 text-lg font-light leading-relaxed max-w-xl'
        >
          Back to Calm is the space she created for the moments in between —
          when you don't need a treatment plan, you just need someone in your
          corner today.
        </p>
        <a
          href='/staff/morgan-adams-msw'
          class='group mt-9 inline-flex items-center gap-2 text-base font-semibold tracking-[0.1em] uppercase text-brand-charcoal hover:text-brand-gold-dark transition-colors duration-300'
        >
          <span>Read Morgan's full profile</span>
          <svg
            class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== INVESTMENT + CTA ==================== -->
  <section class='relative calm-gradient py-24 md:py-36 overflow-hidden' aria-label='Book a session'>
    <div
      class='absolute -bottom-40 -right-32 w-[520px] h-[520px] rounded-full bg-calm-lavender/80 blur-[140px] calm-float pointer-events-none'
      aria-hidden='true'
    >
    </div>

    <div class='relative max-w-4xl mx-auto px-6 sm:px-10 text-center'>
      <span
        class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-gold-dark block mb-6'
        data-animate
      >
        A small investment in feeling better
      </span>

      <h2
        class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.05] tracking-[-0.01em]'
        data-animate
      >
        You don't have to solve everything today.
      </h2>

      <p
        class='mt-7 text-brand-charcoal/60 text-lg font-light leading-relaxed max-w-2xl mx-auto'
        data-animate
      >
        We often spend money on things that offer only temporary enjoyment. For
        $125, you can invest in something more meaningful: an hour of
        personalized support that helps you feel lighter, calmer, and more at
        ease. Book one session whenever you need support, or schedule as many as
        you'd like. Online and in-person sessions offer the same personalized
        experience.
      </p>

      <!-- Price card -->
      <div
        class='mt-12 inline-flex flex-col items-center rounded-[2rem] bg-brand-white/80 border border-brand-gold/20 px-12 py-10 shadow-[0_25px_60px_-40px_rgba(36,30,78,0.6)]'
        data-animate
      >
        <span
          class='font-mono text-[10px] tracking-[0.3em] uppercase text-brand-muted mb-4'
        >
          One session
        </span>
        <span
          class='text-6xl md:text-7xl font-display font-semibold text-brand-charcoal leading-none'
        >
          $125
        </span>
        <span class='mt-4 text-brand-charcoal/55 text-[15px]'>
          60 minutes · Online or in person
        </span>
        <a
          href='/get-started/appointment-request'
          class='group mt-8 inline-flex items-center gap-3 px-8 py-4 text-sm font-semibold tracking-[0.06em] uppercase bg-brand-gold-dark text-white rounded-full transition-all duration-400 hover:bg-brand-blue-light'
        >
          <span>Book your Back to Calm session</span>
          <svg
            class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
          </svg>
        </a>
        <a
          href='tel:8136092034'
          class='mt-5 font-mono text-[13px] text-brand-gold-dark hover:text-brand-charcoal transition-colors'
        >
          or call 813-609-2034
        </a>
      </div>

      <p
        class='mt-14 text-2xl md:text-3xl font-display italic text-brand-charcoal/70 leading-snug max-w-2xl mx-auto'
        data-animate
      >
        Sometimes, you just need help finding your way back to calm.
      </p>
    </div>
  </section>
</Layout>

<script>
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("is-visible");
      });
    },
    { threshold: 0.1 },
  );
  document.querySelectorAll("[data-animate]").forEach((el) => obs.observe(el));
</script>
