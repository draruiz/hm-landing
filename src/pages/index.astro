---
import CTAMapSection from "../components/ui/CTAMapSection.astro";
import EvaluationsSection from "../components/ui/EvaluationsSection.astro";
import Hero from "../components/ui/Hero.astro";
import ServicesSection from "../components/ui/ServicesSection.astro";
import StaffSection from "../components/ui/StaffSection.astro";
import WelcomeSection from "../components/ui/WelcomeSection.astro";
import WorkshopsSection from "../components/ui/WorkshopsSection.astro";
import Layout from "../layouts/Layout.astro";
import { localBusinessSchema, websiteSchema } from "../utils/seo";

const siteUrl = "https://healthymindspecialists.com";
const siteName = "Healthy Mind Specialists";

const schemas = [
  websiteSchema(siteUrl, siteName),
  localBusinessSchema({
    name: siteName,
    description:
      "Integrative psychological services providing individual, couples, family, and group therapy in a compassionate environment.",
    url: siteUrl,
    image: `${siteUrl}/og-default.png`,
    telephone: "813-609-2034",
    address: {
      street: "11906 Boyette Rd",
      city: "Riverview",
      region: "FL",
      country: "US",
      postal: "33569",
    },
  }),
];
---

<Layout
  title='Healthy Mind Specialists | Psychological Services in Tampa FL'
  description='Specializing in comprehensive psychological evaluations, therapy, and clinical support for adults, children, adolescents, families, and professionals. Services available throughout Florida and around the world.'
  schema={schemas}
>
  <Hero
    heading='Healthy Mind Specialists'
    subheading='Psychological Services for Anxiety, OCD, Trauma, and the Parts of Life That Feel Hard to Navigate'
    ctaText='Book an Appointment'
    ctaHref='/get-started/appointment-request'
    secondaryCtaText='Explore Services'
    secondaryCtaHref='/#services'
    backgroundImageSrc='https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/e23cb054-bee6-463b-55fd-72681bfb9500/public'
  />

  <WelcomeSection />
  <ServicesSection />
  <EvaluationsSection />
  <WorkshopsSection />
  <StaffSection />
  <CTAMapSection />
</Layout>
