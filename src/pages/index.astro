---
import BackToCalmSection from "../components/ui/BackToCalmSection.astro";
import CTAMapSection from "../components/ui/CTAMapSection.astro";
import EvaluationsSection from "../components/ui/EvaluationsSection.astro";
import Hero from "../components/ui/Hero.astro";
import InsuranceSection from "../components/ui/InsuranceSection.astro";
import ServicesSection from "../components/ui/ServicesSection.astro";
import StaffSection from "../components/ui/StaffSection.astro";
import WelcomeSection from "../components/ui/WelcomeSection.astro";
import WorkshopsSection from "../components/ui/WorkshopsSection.astro";
import Layout from "../layouts/Layout.astro";
import { localBusinessSchema, websiteSchema } from "../utils/seo";

const siteUrl = "https://www.healthymindspecialists.com";
const siteName = "Healthy Mind Specialists";

const schemas = [
  websiteSchema(siteUrl, siteName),
  localBusinessSchema({
    name: siteName,
    description:
      "Psychologists and therapists in Riverview, FL offering therapy for anxiety, OCD, trauma and EMDR, plus psychological, ADHD, and autism evaluations for children, teens, and adults. In person or online throughout Florida.",
    url: siteUrl,
    image: `${siteUrl}/og-default.png`,
    telephone: "+1-813-609-2034",
    address: {
      street: "11906 Boyette Rd",
      city: "Riverview",
      region: "FL",
      country: "US",
      postal: "33569",
    },
  }),
];
---

<Layout
  title='Therapy & Psychological Testing in Riverview, FL'
  description='Psychologists and therapists in Riverview, FL. Therapy for anxiety, OCD and trauma, plus ADHD and autism evaluations. In person or online. Insurance accepted.'
  schema={schemas}
  navOnLight
>
  <Hero />
  <InsuranceSection />
  <WelcomeSection />
  <BackToCalmSection />
  <ServicesSection />
  <EvaluationsSection />
  <WorkshopsSection />
  <StaffSection />
  <CTAMapSection />
</Layout>
