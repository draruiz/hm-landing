---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema, faqSchema } from "../../utils/seo";

const siteUrl = "https://healthymindspecialists.com";

const schemas = [
  breadcrumbSchema([
    { name: "Home", url: siteUrl },
    { name: "Testing Center", url: `${siteUrl}/services/evaluations` },
    {
      name: "Adult Autism Evaluations",
      url: `${siteUrl}/services/autism-evaluation`,
    },
  ]),
  faqSchema([
    {
      question: "How long does the autism evaluation process take?",
      answer:
        "The evaluation typically spans 2–4 sessions over several weeks. The full process — from intake to final report — usually takes 3–6 weeks.",
    },
    {
      question: "Can adults be evaluated for autism?",
      answer:
        "Absolutely. Many adults are diagnosed for the first time in adulthood. A diagnosis at any age brings important clarity and opens doors to appropriate support.",
    },
    {
      question: "Is the evaluation covered by insurance?",
      answer:
        "Self-pay evaluations range from $1,200 to $1,800. We accept Oscar, Aetna, United Healthcare, and other participating insurance plans.",
    },
  ]),
];

const signsForAdults = [
  "You feel socially drained after most interactions",
  "You constantly overanalyze conversations",
  "You've always felt different or misunderstood",
  "You struggle with emotional regulation or shutdowns",
  "You need routines and predictability to feel stable",
  "Sensory input easily overwhelms you",
  "Relationships feel confusing or exhausting",
  "You feel like you're \"performing\" socially",
  "Previous diagnoses never fully explained your experience",
];

const signsForChildren = [
  "Difficulty with social interaction or communication",
  "Intense emotional reactions or meltdowns",
  "Sensory sensitivities (sound, light, texture, etc.)",
  "Repetitive behaviors or rigid routines",
  "Difficulty adapting to change",
  "Trouble making or maintaining friendships",
  "High intelligence paired with emotional or behavioral struggles",
];

const afterEvaluationSteps = [
  {
    title: "Therapy",
    description:
      "For anxiety, emotional regulation, relationships, or burnout — tailored to your unique neurological profile.",
    icon: "M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z",
  },
  {
    title: "Coaching & Mentoring",
    description:
      "Specialized coaching to build practical life skills, communication strategies, and day-to-day independence.",
    icon: "M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z",
  },
  {
    title: "ADHD Support",
    description:
      "If attention difficulties are also present, we address them as part of a complete, integrated picture of your needs.",
    icon: "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z",
  },
  {
    title: "Executive Functioning Tools",
    description:
      "Practical strategies for organization, planning, emotional regulation, and managing daily demands.",
    icon: "M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z",
  },
  {
    title: "Parent Guidance",
    description:
      "Education and practical support to help families understand the evaluation findings and implement them at home.",
    icon: "M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25",
  },
  {
    title: "School & Work Recommendations",
    description:
      "Personalized accommodations and documentation to support academic performance, workplace adjustments, and daily functioning.",
    icon: "M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5",
  },
];

const faqs = [
  {
    question: "How long does the autism evaluation process take?",
    answer:
      "The evaluation typically spans 2–4 sessions over several weeks, depending on the individual's age and the complexity of the concerns. The full process — from intake to final report — usually takes 3–6 weeks.",
  },
  {
    question: "What instruments do you use to evaluate for autism?",
    answer:
      "We use the ADOS-2 (Autism Diagnostic Observation Schedule) and ADI-R (Autism Diagnostic Interview – Revised), which are the gold-standard tools for autism assessment, supplemented by cognitive, adaptive, and emotional measures as clinically indicated.",
  },
  {
    question: "Can adults be evaluated for autism?",
    answer:
      "Absolutely. Many adults are diagnosed for the first time in adulthood, and we have significant experience supporting late-identified individuals. A diagnosis at any age can bring important clarity and open doors to appropriate support.",
  },
  {
    question: "Will I receive a written report?",
    answer:
      "Yes. Every evaluation includes a comprehensive written report detailing clinical findings, diagnostic impressions, and individualized recommendations. This report can be shared with schools, medical providers, therapists, and support agencies.",
  },
  {
    question: "Is masking common and can it affect the evaluation?",
    answer:
      "Yes — masking (consciously or unconsciously concealing autistic traits) is very common, especially in women, professionals, and high-functioning individuals. Our clinicians are trained to recognize masked presentations and use multiple data sources to ensure an accurate picture.",
  },
];
---

<Layout
  title='Adult Autism Evaluations — Finally Understand Yourself or Your Child'
  description='Compassionate autism evaluations for adults and children in Tampa, FL. Gold-standard assessments, individualized reports, and real next steps — not just a diagnosis.'
  schema={schemas}
>
  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- HERO                                                        -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class='relative overflow-hidden bg-brand-blue' id='autism-hero'>
    <img
      src='https://images.unsplash.com/photo-1607748851687-ba9a10438621?w=1920&h=1080&fit=crop&q=80'
      alt=''
      width='1920'
      height='1080'
      class='absolute inset-0 w-full h-full object-cover'
      loading='eager'
      fetchpriority='high'
      aria-hidden='true'
    />
    <div class='absolute inset-0 bg-brand-blue/78'></div>
    <div
      class='absolute inset-0 opacity-[0.06] pointer-events-none'
      aria-hidden='true'
    >
      <div
        class='absolute -top-32 -left-32 w-[600px] h-[600px] bg-brand-gold rounded-full blur-[140px]'
      ></div>
      <div
        class='absolute -bottom-40 -right-20 w-[500px] h-[500px] bg-brand-gold-light rounded-full blur-[120px]'
      ></div>
    </div>
    <div
      class='absolute inset-0 opacity-[0.03]'
      style='background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;'
      aria-hidden='true'
    ></div>

    <div
      class='relative z-10 max-w-5xl mx-auto px-6 pt-36 pb-24 md:pt-44 md:pb-32 text-center'
    >
      <div
        class='flex items-center justify-center gap-3 mb-6'
        aria-hidden='true'
      >
        <span class='block w-10 h-[1.5px] bg-brand-gold'></span>
        <span class='block w-2.5 h-2.5 rounded-full border border-brand-gold'
        ></span>
        <span class='block w-10 h-[1.5px] bg-brand-gold'></span>
      </div>

      <p
        class='text-brand-gold font-mono text-xs tracking-[0.3em] uppercase mb-4'
      >
        Testing Center
      </p>

      <h1
        class='text-4xl md:text-6xl lg:text-7xl font-display italic text-white leading-tight'
      >
        Adult Autism<br />
        <span class='text-brand-gold-light'>Evaluations</span>
      </h1>

      <p
        class='mt-6 text-white/65 text-lg md:text-xl lg:text-2xl max-w-3xl mx-auto font-sans leading-relaxed'
      >
        Finally understand yourself — or your child — with clarity, not
        guesswork.
      </p>

      <div class='mt-10 flex flex-wrap items-center justify-center gap-4'>
        <a
          href='/get-started/appointment-request'
          class='inline-flex items-center px-8 py-4 text-base font-semibold rounded-full bg-brand-gold text-brand-blue hover:bg-brand-gold-light transition-all duration-300'
        >
          Schedule an Evaluation
          <svg
            class='w-5 h-5 ml-2'
            fill='none'
            viewBox='0 0 24 24'
            stroke-width='2'
            stroke='currentColor'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3'></path>
          </svg>
        </a>
        <a
          href='/get-started/faqs'
          class='inline-flex items-center px-8 py-4 text-base font-medium rounded-full border border-white/30 text-white hover:border-brand-gold hover:text-brand-gold transition-all duration-300'
        >
          Read FAQs
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- INTRO — Split image + text                                 -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class='py-24 md:py-36 overflow-hidden'>
    <div class='max-w-7xl mx-auto px-6'>
      <div class='grid lg:grid-cols-2 gap-12 lg:gap-20 items-center'>
        <div class='relative'>
          <div class='rounded-3xl overflow-hidden shadow-2xl'>
            <img
              src='https://images.unsplash.com/photo-1544027993-37dbfe43562a?w=800&h=1000&fit=crop&q=80'
              alt='Clinician and client engaged in a warm, supportive evaluation consultation'
              width='800'
              height='1000'
              loading='lazy'
              class='w-full h-[400px] md:h-[550px] object-cover'
            />
          </div>
          <div
            class='absolute -bottom-6 -right-6 w-48 h-48 bg-brand-gold/10 rounded-3xl -z-10'
            aria-hidden='true'
          ></div>
          <div
            class='absolute -top-6 -left-6 w-32 h-32 border-2 border-brand-gold/20 rounded-3xl -z-10'
            aria-hidden='true'
          ></div>
        </div>

        <div>
          <span
            class='inline-block text-sm font-semibold text-brand-gold uppercase tracking-widest mb-4'
            >A Proper Evaluation Changes Everything</span
          >
          <h2
            class='text-3xl md:text-4xl lg:text-5xl font-display italic text-brand-blue mb-6 leading-tight'
          >
            Finally Understand Yourself<br />— Or Your Child
          </h2>
          <div class='space-y-5 text-lg text-brand-blue/70 leading-relaxed'>
            <p>
              For years, many adults live feeling misunderstood, emotionally
              overwhelmed, socially exhausted, or &ldquo;different&rdquo;
              without knowing why. Many parents also spend years wondering:
            </p>
            <ul class='space-y-2 pl-5 list-none'>
              {
                [
                  "Why does my child react this way?",
                  "Why are social situations so difficult for them?",
                  "Why do they seem overwhelmed so easily?",
                  "Why does nothing fully explain what they're experiencing?",
                ].map((q) => (
                  <li class='flex items-start gap-3 text-brand-blue/70'>
                    <span class='mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-brand-gold'></span>
                    <span>&ldquo;{q}&rdquo;</span>
                  </li>
                ))
              }
            </ul>
            <p>
              Sometimes it&rsquo;s anxiety. Sometimes ADHD. Sometimes trauma.
              And sometimes&hellip; it&rsquo;s undiagnosed autism. A proper
              evaluation can change everything.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- AUTISM LOOKS DIFFERENT                                     -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class='py-24 md:py-36 bg-brand-blue overflow-hidden'>
    <div class='max-w-7xl mx-auto px-6'>
      <div class='grid lg:grid-cols-2 gap-16 items-center'>
        <div>
          <span
            class='inline-block text-sm font-semibold text-brand-gold uppercase tracking-widest mb-4'
            >The Hidden Spectrum</span
          >
          <h2
            class='text-3xl md:text-4xl lg:text-5xl font-display italic text-white mb-8 leading-tight'
          >
            Autism Often Looks Different<br />
            <span class='text-brand-gold-light'>Than People Expect</span>
          </h2>
          <div class='space-y-5 text-lg text-white/65 leading-relaxed'>
            <p>
              Many intelligent, high-functioning adults and children go
              undiagnosed for years because they learned to mask their
              struggles. They may appear successful, verbal, independent,
              emotionally intelligent, or &ldquo;fine&rdquo; on the outside.
            </p>
            <p>
              Internally, they are navigating burnout, sensory overwhelm,
              emotional dysregulation, social exhaustion, chronic anxiety,
              difficulty connecting, rigid thinking patterns, or feeling
              disconnected from others their entire life.
            </p>
            <p>
              This is especially common in adults, women, professionals, and
              high-functioning individuals. The mask is convincing — but the
              exhaustion of maintaining it is real.
            </p>
          </div>
        </div>

        <!-- Masking visual card -->
        <div class='relative'>
          <div
            class='bg-white/5 border border-white/10 rounded-3xl p-10 backdrop-blur-sm'
          >
            <div
              class='flex items-center gap-3 mb-8 pb-6 border-b border-white/10'
            >
              <div
                class='w-10 h-10 rounded-xl bg-brand-gold/20 flex items-center justify-center'
              >
                <svg
                  class='w-5 h-5 text-brand-gold'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke-width='1.5'
                  stroke='currentColor'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z'
                  ></path>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M15 12a3 3 0 11-6 0 3 3 0 016 0z'></path>
                </svg>
              </div>
              <p class='text-sm font-semibold text-brand-gold uppercase tracking-widest'>
                What others see
              </p>
            </div>
            <div class='grid grid-cols-2 gap-3 mb-8'>
              {
                [
                  "Successful",
                  "Verbal",
                  "Independent",
                  "High-functioning",
                  "Emotionally intelligent",
                  '"Fine"',
                ].map((trait) => (
                  <div class='flex items-center gap-2.5 text-white/70 text-sm'>
                    <span class='w-1.5 h-1.5 rounded-full bg-brand-gold/60 shrink-0'></span>
                    {trait}
                  </div>
                ))
              }
            </div>
            <div class='border-t border-white/10 pt-6 mt-2'>
              <div class='flex items-center gap-3 mb-5'>
                <div
                  class='w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center'
                >
                  <svg
                    class='w-5 h-5 text-white/50'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='1.5'
                    stroke='currentColor'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88'
                    ></path>
                  </svg>
                </div>
                <p class='text-sm font-semibold text-white/40 uppercase tracking-widest'>
                  The internal reality
                </p>
              </div>
              <div class='grid grid-cols-2 gap-3'>
                {
                  [
                    "Burnout",
                    "Sensory overwhelm",
                    "Social exhaustion",
                    "Chronic anxiety",
                    "Emotional dysregulation",
                    "Disconnection",
                  ].map((trait) => (
                    <div class='flex items-center gap-2.5 text-white/40 text-sm'>
                      <span class='w-1.5 h-1.5 rounded-full bg-white/20 shrink-0'></span>
                      {trait}
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
          <div
            class='absolute -bottom-8 -right-8 w-56 h-56 bg-brand-gold/5 rounded-full blur-2xl pointer-events-none'
            aria-hidden='true'
          ></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- SIGNS — Two-column comparison                             -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class='py-24 md:py-36 overflow-hidden'>
    <div class='max-w-7xl mx-auto px-6'>
      <div class='mb-16 text-center'>
        <span
          class='inline-block text-sm font-semibold text-brand-gold uppercase tracking-widest mb-4'
          >Recognizing the Signs</span
        >
        <h2
          class='text-3xl md:text-4xl lg:text-5xl font-display italic text-brand-blue leading-tight'
        >
          Signs You Should Consider<br />An Autism Evaluation
        </h2>
        <p class='mt-6 text-lg text-brand-blue/60 max-w-2xl mx-auto'>
          These signs look different across age groups. If several of these
          resonate — for yourself or your child — an evaluation can bring the
          clarity you have been searching for.
        </p>
      </div>

      <div class='grid md:grid-cols-2 gap-8'>
        <!-- Adults -->
        <div
          class='relative bg-brand-blue rounded-3xl p-10 overflow-hidden shadow-xl'
        >
          <div
            class='absolute top-0 right-0 w-64 h-64 bg-brand-gold/5 rounded-full blur-3xl pointer-events-none'
            aria-hidden='true'
          ></div>
          <div class='relative z-10'>
            <div class='flex items-center gap-4 mb-8'>
              <div
                class='w-12 h-12 rounded-2xl bg-brand-gold/15 flex items-center justify-center'
              >
                <svg
                  class='w-6 h-6 text-brand-gold'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke-width='1.5'
                  stroke='currentColor'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z'
                  ></path>
                </svg>
              </div>
              <div>
                <p
                  class='text-brand-gold font-mono text-xs tracking-widest uppercase'
                >
                  For Adults
                </p>
                <h3 class='text-xl font-display font-bold text-white'>
                  Signs in Adults
                </h3>
              </div>
            </div>
            <ul class='space-y-4'>
              {
                signsForAdults.map((sign) => (
                  <li class='flex items-start gap-3 text-white/70'>
                    <span class='mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-brand-gold'></span>
                    <span class='leading-relaxed'>{sign}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Children -->
        <div
          class='relative bg-brand-cream/60 rounded-3xl p-10 overflow-hidden shadow-sm border border-brand-charcoal/8'
        >
          <div
            class='absolute bottom-0 left-0 w-64 h-64 bg-brand-gold/8 rounded-full blur-3xl pointer-events-none'
            aria-hidden='true'
          ></div>
          <div class='relative z-10'>
            <div class='flex items-center gap-4 mb-8'>
              <div
                class='w-12 h-12 rounded-2xl bg-brand-blue/10 flex items-center justify-center'
              >
                <svg
                  class='w-6 h-6 text-brand-blue'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke-width='1.5'
                  stroke='currentColor'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18'
                  ></path>
                </svg>
              </div>
              <div>
                <p
                  class='text-brand-gold font-mono text-xs tracking-widest uppercase'
                >
                  For Children
                </p>
                <h3 class='text-xl font-display font-bold text-brand-blue'>
                  Signs in Children
                </h3>
              </div>
            </div>
            <ul class='space-y-4'>
              {
                signsForChildren.map((sign) => (
                  <li class='flex items-start gap-3 text-brand-blue/70'>
                    <span class='mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-brand-gold'></span>
                    <span class='leading-relaxed'>{sign}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════ -->
  <!-- WHY GETTING EVALUATED MATTERS                             -->
  <!-- ═══════════════════════════════════════════════════════════ -->
  <section class='py-24 md:py-36 bg-brand-cream/40 overflow-hidden'>
    <div class='max-w-7xl mx-auto px-6'>
      <div class='grid lg:grid-cols-2 gap-16 items-center'>
        <div>
          <span
            class='inline-block text-sm font-semibold text-brand-gold uppercase tracking-widest mb-4'
            >Why It Matters</span
          >
          <h2
            class='text-3xl md:text-4xl lg:text-5xl font-display italic text-brand-blue mb-8 leading-tight'
          >
            Why Getting Evaluated Matters
          </h2>
