---
import Footer from "../components/layout/Footer.astro";
import FloatingCallButton from "../components/ui/FloatingCallButton.astro";
import LanguageToggle from "../components/ui/LanguageToggle.astro";
import Navbar from "../components/layout/Navbar.astro";
import SEOHead from "../components/seo/SEOHead.astro";
import SchemaOrg from "../components/seo/SchemaOrg.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Set on pages whose hero is light (e.g. Back to Calm). The navbar is
   * transparent over the hero, so it needs dark links and the dark logo
   * instead of the white-on-dark-hero default.
   */
  navOnLight?: boolean;
}

const { schema, navOnLight, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <!-- i18n: hide content for Spanish visitors until translated (avoids flash of English). -->
    <script is:inline>
      try {
        if (localStorage.getItem("hm-lang") === "es") {
          document.documentElement.classList.add("i18n-pending");
          // Safety net: never keep the page hidden if the engine fails to load.
          setTimeout(function () {
            document.documentElement.classList.remove("i18n-pending");
          }, 1500);
        }
      } catch (e) {}
    </script>
    <style is:inline>
      html.i18n-pending body {
        visibility: hidden;
      }
    </style>
    <SEOHead {...seoProps} />
    <!-- Fonts: non-blocking preload -->
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      rel='preload'
      as='style'
      href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Pinyon+Script&display=swap'
    />
    <link
      rel='stylesheet'
      href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Pinyon+Script&display=swap'
      media='print'
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel='stylesheet'
        href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Pinyon+Script&display=swap'
      />
    </noscript>
    <!-- Google tag (gtag.js) -->
    <script
      async
      src='https://www.googletagmanager.com/gtag/js?id=AW-11085040380'
      is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "AW-11085040380");
    </script>
  </head>
  <body
    class='min-h-screen flex flex-col bg-brand-white text-brand-charcoal font-sans antialiased'
  >
    <Navbar onLight={navOnLight} />
    <main class='flex-1'>
      <slot />
    </main>
    <Footer />
    <LanguageToggle />
    <FloatingCallButton />
    {schema && <SchemaOrg schema={schema} />}
  </body>
</html>
