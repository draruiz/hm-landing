---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
}

const {
  title,
  description,
  canonical: canonicalProp,
  ogImage = "/og-default.png",
  ogType = "website",
  noindex = false,
  publishedDate,
  modifiedDate,
  author,
} = Astro.props;

const siteName = "Healthy Mind Specialists";
// Pages that already carry the brand in their title don't get it twice.
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// One canonical form per page: site origin, no query, no trailing slash
// (except the root). Matches internal links, the sitemap and vercel.json.
const canonicalUrl = new URL(canonicalProp ?? Astro.url.pathname, Astro.site);
canonicalUrl.search = "";
canonicalUrl.hash = "";
if (canonicalUrl.pathname !== "/") {
  canonicalUrl.pathname = canonicalUrl.pathname.replace(/\/+$/, "");
}
const canonical = canonicalUrl.href;
const ogImageUrl = new URL(ogImage, Astro.site);
const isDefaultOgImage = ogImage === "/og-default.png";
---

<meta charset='UTF-8' />
<meta name='viewport' content='width=device-width, initial-scale=1' />

<!-- Primary SEO -->
<title>{fullTitle}</title>
<meta name='description' content={description} />
<link rel='canonical' href={canonical} />
{noindex && <meta name='robots' content='noindex, nofollow' />}

<!-- Open Graph -->
<meta property='og:title' content={fullTitle} />
<meta property='og:description' content={description} />
<meta property='og:url' content={canonical} />
<meta property='og:type' content={ogType} />
<meta property='og:image' content={ogImageUrl} />
{
  isDefaultOgImage && (
    <>
      <meta property='og:image:width' content='1200' />
      <meta property='og:image:height' content='630' />
      <meta
        property='og:image:alt'
        content='Healthy Mind Specialists office in Riverview, Florida'
      />
    </>
  )
}
<meta property='og:site_name' content={siteName} />
<meta property='og:locale' content='en_US' />

<!-- Twitter Card -->
<meta name='twitter:card' content='summary_large_image' />
<meta name='twitter:title' content={fullTitle} />
<meta name='twitter:description' content={description} />
<meta name='twitter:image' content={ogImageUrl} />

<!-- Article metadata -->
{
  publishedDate && (
    <meta property='article:published_time' content={publishedDate} />
  )
}
{
  modifiedDate && (
    <meta property='article:modified_time' content={modifiedDate} />
  )
}
{author && <meta property='article:author' content={author} />}

<!-- Favicons -->
<link rel='icon' href='/favicon.ico' sizes='32x32' />
<link rel='icon' type='image/png' href='/favicon-48.png' sizes='48x48' />
<link rel='apple-touch-icon' href='/apple-touch-icon.png' />
<meta name='theme-color' content='#fbf9f6' />

<!-- Sitemap discovery -->
<link rel='sitemap' href='/sitemap-index.xml' />

<!-- LLMs.txt for Generative Engine Optimization (GEO) -->
<link rel='help' type='text/plain' href='/llms.txt' />

