---
/**
 * Visit — address, phone and hours next to the map. The H2 names the city
 * (local search), and the map embed queries the practice by name + address.
 */
---

<section class='relative bg-brand-white' aria-labelledby='visit-title'>
  <div class='grid grid-cols-1 lg:grid-cols-2'>
    <!-- Left: Contact info -->
    <div
      class='flex flex-col justify-center px-6 sm:px-10 md:px-16 lg:px-20 py-20 md:py-28'
    >
      <h2
        id='visit-title'
        class='font-display font-semibold text-[2.6rem] sm:text-5xl md:text-6xl leading-[1.04] tracking-[-0.015em] text-brand-charcoal'
      >
        Visit us <em class='italic font-medium text-brand-gold-dark'>in Riverview</em>
      </h2>
      <p class='mt-5 max-w-md text-lg text-brand-charcoal/70 leading-relaxed'>
        Sessions in person at our Riverview office, or online throughout
        Florida and beyond.
      </p>

      <address class='not-italic mt-10 space-y-4 text-lg text-brand-charcoal/80'>
        <p class='flex items-start gap-3'>
          <svg
            class='w-5 h-5 text-brand-gold-dark flex-shrink-0 mt-1'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='1.5'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M15 10.5a3 3 0 11-6 0 3 3 0 016 0z'></path>
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z'
            ></path>
          </svg>
          <span>11906 Boyette Rd<br />Riverview, FL 33569</span>
        </p>
        <p class='flex items-center gap-3'>
          <svg
            class='w-5 h-5 text-brand-gold-dark flex-shrink-0'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='1.5'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z'
            ></path>
          </svg>
          <a
            href='tel:8136092034'
            class='font-semibold text-brand-charcoal hover:text-brand-gold-dark transition-colors'>813-609-2034</a
          >
        </p>
        <p class='flex items-center gap-3'>
          <svg
            class='w-5 h-5 text-brand-gold-dark flex-shrink-0'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='1.5'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z'></path>
          </svg>
          <span>Mon – Fri, 8AM – 9PM</span>
        </p>
      </address>

      <a
        href='https://maps.google.com/?q=11906+Boyette+Rd+Riverview+FL+33569'
        target='_blank'
        rel='noopener noreferrer'
        class='group mt-10 inline-flex w-fit items-center gap-3 rounded-full border border-brand-charcoal/20 px-7 py-3.5 text-[15px] font-semibold text-brand-charcoal transition-colors duration-300 hover:border-brand-gold-dark hover:text-brand-gold-dark'
      >
        <span>Get Directions</span>
        <svg
          class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
        </svg>
      </a>
    </div>

    <!-- Right: Map -->
    <div class='relative min-h-[420px] lg:min-h-[560px] bg-brand-gray-light'>
      <iframe
        src='https://www.google.com/maps?q=Healthy+Mind+Specialists,+11906+Boyette+Rd,+Riverview,+FL+33569&output=embed'
        class='absolute inset-0 w-full h-full border-0 grayscale-[0.6]'
        allowfullscreen
        loading='lazy'
        referrerpolicy='no-referrer-when-downgrade'
        title='Healthy Mind Specialists office location'></iframe>
    </div>
  </div>
</section>
