---
/**
 * Homepage hero — light, split layout led by the real office photo.
 * The H1 carries the primary search phrase (service + location) and renders
 * visible on first paint (no JS-gated entrance), which keeps LCP fast.
 */
import { acceptedInsurance } from "../../data/insurance";

const photoSrc =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/e23cb054-bee6-463b-55fd-72681bfb9500/public";

const highlights = [
  "30+ years of practice",
  "Children, teens & adults",
  "Therapy in English & Spanish",
];
---

<section
  id='hero'
  class='hero relative overflow-hidden pt-32 pb-20 md:pt-36 md:pb-28'
  aria-labelledby='hero-title'
>
  <div
    class='relative max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-12 items-center'
  >
    <!-- Copy -->
    <div class='lg:col-span-6 xl:col-span-6'>
      <h1
        id='hero-title'
        class='font-display font-semibold text-brand-charcoal text-[2.6rem] sm:text-[3.5rem] lg:text-[3.6rem] xl:text-[4.1rem] leading-[1.03] tracking-[-0.02em] text-balance'
      >
        Therapy &amp; psychological testing <em
          class='italic font-medium text-brand-gold-dark'
          >in Riverview, Florida</em
        >
      </h1>

      <p
        class='mt-7 max-w-xl text-lg md:text-xl text-brand-charcoal/75 leading-relaxed'
      >
        Care for anxiety, OCD, trauma, and the parts of life that feel hard to
        navigate, plus ADHD and autism evaluations for children, teens, and
        adults. In person in Riverview, or online throughout Florida and beyond.
      </p>

      <div class='mt-10 flex flex-col sm:flex-row gap-3'>
        <a
          href='/get-started/appointment-request'
          class='group inline-flex items-center justify-center gap-3 rounded-full bg-brand-gold-dark px-8 py-4 text-[15px] font-semibold text-white shadow-[0_12px_28px_-14px_rgba(106,84,168,0.9)] transition-[background-color,transform] duration-300 hover:bg-brand-blue active:scale-[0.98]'
        >
          <span>Book an appointment</span>
          <svg
            class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
          </svg>
        </a>
        <a
          href='tel:+18136092034'
          class='inline-flex items-center justify-center gap-3 rounded-full border border-brand-charcoal/20 px-8 py-4 text-[15px] font-semibold text-brand-charcoal transition-colors duration-300 hover:border-brand-gold-dark hover:text-brand-gold-dark'
        >
          <svg
            class='w-4 h-4'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='1.8'
            aria-hidden='true'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z'
            ></path>
          </svg>
          <span>Call 813-609-2034</span>
        </a>
      </div>

      <ul
        class='mt-10 flex flex-wrap gap-x-5 gap-y-2 text-[15px] text-brand-charcoal/70'
      >
        {
          highlights.map((item) => (
            <li class='flex items-center gap-2.5'>
              <svg
                class='w-4 h-4 text-brand-gold-dark flex-shrink-0'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M4.5 12.75l6 6 9-13.5'
                />
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Photo -->
    <div class='lg:col-span-6 relative'>
      <!-- Brand arch behind the photo -->
      <div
        class='hero-arch absolute right-0 -top-10 md:-top-16 w-[62%] h-[calc(100%+0.5rem)] md:h-[calc(100%+2rem)] rounded-t-full bg-calm-lavender'
        aria-hidden='true'
      >
      </div>

      <figure
        class='relative mt-10 lg:mt-16 overflow-hidden rounded-[1.75rem] bg-calm-lavender shadow-[0_40px_70px_-40px_rgba(36,30,78,0.55)]'
      >
        <img
          class='hero-photo block w-full h-auto aspect-[1139/768] object-cover'
          src={photoSrc}
          alt='Inside the Healthy Mind Specialists office in Riverview, Florida'
          width='1139'
          height='768'
          loading='eager'
          fetchpriority='high'
          decoding='async'
        />
      </figure>

      <!-- Insurance shortcut -->
      <a
        href='#insurance'
        class='group absolute -bottom-8 left-4 sm:left-8 right-4 sm:right-auto flex items-center gap-4 rounded-2xl bg-brand-white px-5 py-4 shadow-[0_18px_40px_-18px_rgba(36,30,78,0.45)] ring-1 ring-brand-charcoal/5 transition-transform duration-300 hover:-translate-y-0.5'
      >
        <span
          class='grid place-items-center w-11 h-11 rounded-full bg-calm-lavender text-brand-gold-dark flex-shrink-0'
          aria-hidden='true'
        >
          <svg
            class='w-5 h-5'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='1.8'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z'
            ></path>
          </svg>
        </span>
        <span class='flex flex-col leading-snug'>
          <span class='text-[15px] font-semibold text-brand-charcoal'>
            {`We accept ${acceptedInsurance.length} insurance plans`}
          </span>
          <span
            class='text-[13px] text-brand-charcoal/65 group-hover:text-brand-gold-dark transition-colors'
          >
            Florida Blue, Cigna, UHC, Optum &amp; more
          </span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(
      180deg,
      var(--color-calm-mist) 0%,
      var(--color-brand-white) 75%
    );
  }

  /* One authored moment: the arch rises behind the photo while the photo
     settles. Both start already visible, so first paint is never blank. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-arch {
      transform-origin: bottom center;
      animation: hero-arch-rise 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero-photo {
      animation: hero-photo-settle 1.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes hero-arch-rise {
    from {
      transform: scaleY(0.82);
      opacity: 0.4;
    }
    to {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @keyframes hero-photo-settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }
</style>
