---
/**
 * Elegant Hero — Full-width background video, centered content, warm rounded CTAs.
 */
export interface Props {
  heading: string;
  subheading?: string;
  ctaText: string;
  ctaHref: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  videoSrc?: string;
  posterSrc?: string;
  backgroundImageSrc?: string;
}

const {
  heading,
  subheading = "Integrative Psychological Services",
  ctaText,
  ctaHref,
  secondaryCtaText,
  secondaryCtaHref,
  videoSrc,
  posterSrc = "/images/hero-poster.jpg",
  backgroundImageSrc,
} = Astro.props;

const headingWords = heading.split(" ");

const marqueeItems = [
  "Individual Therapy",
  "Couples Counseling",
  "EMDR",
  "Psychological Evaluations",
  "ADHD Assessments",
  "Group Therapy",
  "Life Coaching",
  "Integrative Care",
];
---

<section
  id='hero'
  class='relative min-h-screen dark-gradient overflow-hidden flex flex-col'
  aria-label='Welcome hero'
>
  <!-- Background media -->
  {
    backgroundImageSrc ? (
      <img
        class='hero-video absolute inset-0 w-full h-full object-contain sm:object-cover sm:scale-105'
        src={backgroundImageSrc}
        alt=''
        loading='eager'
        decoding='async'
        aria-hidden='true'
      />
    ) : (
      <video
        class='hero-video absolute inset-0 w-full h-full object-cover scale-105'
        autoplay
        muted
        loop
        playsinline
        preload='metadata'
        poster={posterSrc}
        aria-hidden='true'
      >
        <source src={videoSrc} type='video/mp4' />
      </video>
    )
  }

  <!-- Gradient overlay -->
  <div
    class='absolute inset-0 bg-gradient-to-b from-brand-blue/85 via-brand-blue/72 to-brand-blue/92'
  >
  </div>

  <!-- Centered content -->
  <div
    class='relative z-10 flex flex-col items-center justify-center flex-1 text-center px-6 sm:px-10 md:px-16 py-36 md:py-44'
  >
    <!-- Subheading label -->
    <!-- <div class='hero-label opacity-0 mb-8 flex flex-col items-center'>
      <span
        class='font-display italic text-xl md:text-2xl tracking-[0.04em] text-brand-gold/90'
      >
        {subheading}
      </span>
      <div class='w-12 h-px bg-brand-gold/40 mt-3'></div>
    </div> -->

    <h1 class='sr-only'>{heading}</h1>

    <!-- Animated heading -->
    <div class='hero-title-wrap mb-10 md:mb-12 max-w-4xl' aria-hidden='true'>
      <p
        class='text-[2.5rem] sm:text-5xl md:text-6xl lg:text-7xl font-display font-semibold text-brand-white leading-[1.1] tracking-[-0.01em]'
      >
        {
          headingWords.map((word) => (
            <span class='hero-word inline-block overflow-hidden mr-[0.25em]'>
              <span class='hero-word-inner inline-block translate-y-full opacity-0'>
                {word}
              </span>
            </span>
          ))
        }
      </p>
    </div>

    <!-- Divider -->
    <div class='hero-divider w-0 h-px bg-brand-gold/50 mb-8'></div>

    <!-- Description -->
    <p
      class='hero-desc opacity-0 text-brand-white/70 text-xl md:text-2xl font-light leading-relaxed max-w-xl mb-12'
    >
      International Mental Health & Psychological Testing Center Specialized
      evaluations, therapy, and clinical support for children, teens, adults,
      families, and professionals in Florida and beyond.
    </p>

    <!-- CTAs -->
    <div
      class='hero-cta flex flex-col sm:flex-row items-center gap-4 opacity-0'
    >
      <a
        href={ctaHref}
        class='group inline-flex items-center gap-3 px-8 py-4 text-base font-semibold tracking-[0.06em] uppercase bg-brand-gold text-brand-blue rounded-full transition-all duration-500 hover:bg-brand-gold-light'
      >
        <span>{ctaText}</span>
        <svg
          class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
        </svg>
      </a>
      {
        secondaryCtaText && secondaryCtaHref && (
          <a
            href={secondaryCtaHref}
            class='group inline-flex items-center gap-3 px-8 py-4 text-base font-medium tracking-[0.06em] uppercase text-brand-white/80 border border-brand-white/30 rounded-full transition-all duration-500 hover:text-brand-white hover:border-brand-white/60 hover:bg-brand-white/5'
          >
            <span>{secondaryCtaText}</span>
            <svg
              class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              stroke-width='2'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M17 8l4 4m0 0l-4 4m4-4H3'
              />
            </svg>
          </a>
        )
      }
    </div>
  </div>

  <!-- Marquee strip -->
  <div
    class='relative z-10 border-t border-brand-white/10 bg-brand-blue-dark/50 backdrop-blur-sm overflow-hidden'
  >
    <div class='marquee-track flex items-center whitespace-nowrap py-4'>
      {
        [...marqueeItems, ...marqueeItems].map((item) => (
          <span class='inline-flex items-center gap-6 mx-6'>
            <span class='font-display text-sm md:text-base font-medium text-brand-white/50 uppercase tracking-[0.1em]'>
              {item}
            </span>
            <span class='block w-1.5 h-1.5 rounded-full bg-brand-gold/40' />
          </span>
        ))
      }
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class='scroll-indicator absolute bottom-20 left-6 sm:left-10 md:left-16 lg:left-20 flex items-center gap-3 opacity-0 z-10'
  >
    <div
      class='w-5 h-9 rounded-full border border-brand-white/25 flex items-start justify-center pt-1.5'
    >
      <span class='scroll-dot block w-1 h-1 rounded-full bg-brand-gold'></span>
    </div>
    <span
      class='font-mono text-[10px] tracking-[0.15em] uppercase text-brand-white/30'
    >
      Scroll
    </span>
  </div>

  <!-- Subtle grid lines -->
  <div class='absolute inset-0 pointer-events-none z-0' aria-hidden='true'>
    <div class='absolute left-[25%] top-0 bottom-0 w-px bg-brand-white/[0.03]'>
    </div>
    <div class='absolute left-[50%] top-0 bottom-0 w-px bg-brand-white/[0.03]'>
    </div>
    <div class='absolute left-[75%] top-0 bottom-0 w-px bg-brand-white/[0.03]'>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (prefersReduced) {
      document
        .querySelectorAll<HTMLElement>(
          ".hero-word-inner, .hero-label, .hero-divider, .hero-desc, .hero-cta, .scroll-indicator",
        )
        .forEach((el) => {
          el.style.opacity = "1";
          el.style.transform = "none";
        });
      const divider = document.querySelector<HTMLElement>(".hero-divider");
      if (divider) divider.style.width = "60px";
      return;
    }

    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

    tl.fromTo(
      ".hero-label",
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8 },
      0.2,
    );

    tl.to(
      ".hero-word-inner",
      { y: 0, opacity: 1, duration: 1, stagger: 0.06, ease: "power4.out" },
      0.4,
    );

    tl.to(
      ".hero-divider",
      { width: "60px", duration: 0.8, ease: "power2.inOut" },
      1.0,
    );

    tl.fromTo(
      ".hero-desc",
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.8 },
      1.1,
    );

    tl.fromTo(
      ".hero-cta",
      { y: 15, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.7 },
      1.3,
    );

    tl.to(".hero-video", { scale: 1, duration: 8, ease: "power1.out" }, 0);

    tl.fromTo(
      ".scroll-indicator",
      { opacity: 0 },
      { opacity: 1, duration: 0.6 },
      2.0,
    );

    gsap.to(".scroll-dot", {
      y: 14,
      duration: 1.5,
      repeat: -1,
      yoyo: true,
      ease: "power1.inOut",
    });
  });
</script>

<style>
  .hero-word-inner {
    will-change: transform, opacity;
  }
</style>
