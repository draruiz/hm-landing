---
/**
 * Back to Calm — featured emotional-support session.
 * Warm lavender band that intentionally breaks the numbered section rhythm:
 * this is a highlight, not another item in the list.
 */
const helpsWith = [
  "When anxiety or panic feels hard to manage",
  "When overthinking keeps you stuck",
  "When you're facing an important decision",
  "When life feels emotionally exhausting",
];

const morganImage =
  "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/b13d28c3-98c3-4dbd-7ba7-d16aefbad700/public";
---

<section
  id='back-to-calm'
  class='relative calm-gradient py-24 md:py-36 overflow-hidden'
  aria-label='Back to Calm'
>
  <!-- Ambient soft shapes -->
  <div
    class='absolute -top-32 -left-32 w-[520px] h-[520px] rounded-full bg-calm-lavender/70 blur-[120px] calm-float pointer-events-none'
    aria-hidden='true'
  >
  </div>
  <div
    class='absolute -bottom-40 -right-24 w-[460px] h-[460px] rounded-full bg-calm-blush/70 blur-[130px] calm-float-slow pointer-events-none'
    aria-hidden='true'
  >
  </div>

  <div
    class='relative max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 items-center'
  >
    <!-- Image — arch shape, like the feed -->
    <div class='lg:col-span-5 order-1' data-animate>
      <div class='relative mx-auto max-w-md lg:max-w-none'>
        <div
          class='absolute -inset-3 rounded-t-[999px] rounded-b-[2.5rem] border border-brand-gold/25 pointer-events-none'
          aria-hidden='true'
        >
        </div>
        <div
          class='relative h-[380px] sm:h-[460px] lg:h-[540px] overflow-hidden rounded-t-[999px] rounded-b-[2.5rem] bg-calm-lavender'
        >
          <img
            src='https://images.unsplash.com/photo-1506126613408-eca07ce68773?w=1000&q=80'
            alt='Person sitting quietly at golden hour, breathing and finding a sense of calm'
            width='1000'
            height='1200'
            class='w-full h-full object-cover'
            loading='lazy'
          />
          <!-- Warm lavender grade so stock photography sits inside the palette -->
          <div
            class='absolute inset-0 bg-gradient-to-br from-brand-gold/35 via-transparent to-calm-blush/45 mix-blend-soft-light pointer-events-none'
            aria-hidden='true'
          >
          </div>
        </div>
        <!-- Price chip -->
        <div
          class='absolute -bottom-5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-brand-white px-6 py-3 shadow-[0_10px_30px_-12px_rgba(36,30,78,0.35)] border border-brand-gold/20'
        >
          <span
            class='font-mono text-[11px] tracking-[0.18em] uppercase text-brand-gold-dark'
          >
            60 min · $125 · Online or in person
          </span>
        </div>
      </div>
    </div>

    <!-- Copy -->
    <div class='lg:col-span-7 order-2' data-animate>
      <span
        class='inline-flex items-center gap-2.5 rounded-full border border-brand-gold/30 bg-brand-white/60 px-4 py-1.5 font-mono text-[10px] tracking-[0.25em] uppercase text-brand-gold-dark mb-7'
      >
        <span class='w-1.5 h-1.5 rounded-full bg-brand-gold' aria-hidden='true'
        ></span>
        New — Emotional Support Session
      </span>

      <h2
        class='text-5xl sm:text-6xl md:text-7xl font-display font-semibold text-brand-charcoal leading-[0.95] tracking-[-0.01em]'
      >
        <span
          class='script-cap text-[1.35em] text-brand-gold-dark mr-0.5 align-baseline'
          aria-hidden='true'>B</span
        ><span class='sr-only'>B</span>ack to <em
          class='not-italic text-brand-gold-dark'>Calm</em
        >
      </h2>

      <p
        class='mt-7 text-brand-charcoal/70 text-xl md:text-2xl font-display italic leading-snug max-w-xl'
      >
        When life feels overwhelming, find your way back to calm.
      </p>

      <p
        class='mt-6 text-brand-charcoal/60 text-base md:text-lg font-light leading-relaxed max-w-xl'
      >
        A personalized 60-minute session with Morgan, designed to help you
        navigate difficult moments, quiet overwhelming thoughts, and reconnect
        with a sense of calm. Not formal therapy — a supportive, flexible space
        where you can talk openly and feel heard.
      </p>

      <!-- When it helps -->
      <ul class='mt-9 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3.5'>
        {
          helpsWith.map((item) => (
            <li class='flex items-start gap-3'>
              <span
                class='mt-[0.55em] w-1.5 h-1.5 rounded-full bg-brand-gold flex-shrink-0'
                aria-hidden='true'
              />
              <span class='text-brand-charcoal/70 text-[15px] leading-relaxed'>
                {item}
              </span>
            </li>
          ))
        }
      </ul>

      <!-- Morgan attribution -->
      <a
        href='/staff/morgan-adams-msw'
        class='group mt-10 inline-flex items-center gap-4 rounded-full bg-brand-white/70 border border-brand-gold/15 py-2 pl-2 pr-6 transition-colors duration-300 hover:bg-brand-white'
      >
        <img
          src={morganImage}
          alt='Morgan Adams, MSW'
          width='96'
          height='96'
          class='w-12 h-12 rounded-full object-cover object-top'
          loading='lazy'
        />
        <span class='flex flex-col leading-tight'>
          <span class='text-[15px] font-semibold text-brand-charcoal'>
            Led by Morgan Adams, MSW
          </span>
          <span
            class='text-[12px] text-brand-charcoal/50 group-hover:text-brand-gold-dark transition-colors duration-300'
          >
            Life &amp; Mindfulness Coach — meet Morgan
          </span>
        </span>
      </a>

      <!-- CTAs -->
      <div class='mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-4'>
        <a
          href='/programs/back-to-calm'
          class='group inline-flex items-center gap-3 px-8 py-4 text-sm font-semibold tracking-[0.06em] uppercase bg-brand-gold-dark text-white rounded-full transition-all duration-400 hover:bg-brand-blue-light'
        >
          <span>Discover Back to Calm</span>
          <svg
            class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
          </svg>
        </a>
        <a
          href='/get-started/appointment-request'
          class='inline-flex items-center gap-2 px-8 py-4 text-sm font-semibold tracking-[0.06em] uppercase border border-brand-charcoal/20 text-brand-charcoal rounded-full transition-all duration-400 hover:border-brand-gold-dark hover:text-brand-gold-dark'
        >
          Book a session
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("is-visible");
      });
    },
    { threshold: 0.1 },
  );
  document
    .querySelectorAll("section[aria-label='Back to Calm'] [data-animate]")
    .forEach((el) => obs.observe(el));
</script>
