---
/**
 * Programs & Workshops Section — Featured programs with editorial layout.
 */
const programs = [
  {
    label: "Teen Program",
    title: "Strong Mind Teens",
    description:
      "A specialized program designed to help adolescents build resilience, emotional regulation, and confidence during their most formative years.",
    href: "/programs/strong-mind-teens",
    // Real program photo (the previous stock image was unrelated food photography).
    image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/b394d150-b3c9-4f09-7ceb-8c15687c9a00/public",
    imageAlt: "Traci Adams in a coaching session with a teenager at Healthy Mind Specialists",
  },
  {
    label: "Community",
    title: "Workshops & Groups",
    description:
      "Interactive workshops and group experiences focused on skill-building, psychoeducation, and community connection.",
    href: "/programs/workshops",
    image: "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1100&q=75&auto=format&fit=crop",
    imageAlt: "Adults participating in a community wellness workshop and group therapy session",
  },
];
---

<section class='relative bg-brand-white py-24 md:py-32' aria-labelledby='programs-title'>
  <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
    <div class='grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-16 items-end mb-14 md:mb-16'>
      <h2
        id='programs-title'
        class='lg:col-span-7 font-display font-semibold text-[2.6rem] sm:text-5xl md:text-6xl leading-[1.04] tracking-[-0.015em] text-brand-charcoal text-balance'
      >
        Programs, Groups &amp; Workshops
      </h2>
      <p class='lg:col-span-5 text-lg text-brand-charcoal/70 leading-relaxed'>
        Beyond therapy. Building skills, confidence, and connection.
      </p>
    </div>

    <div class='grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-8'>
      {
        programs.map((prog) => (
          <a href={prog.href} class='group block'>
            <div class='relative aspect-[5/4] overflow-hidden rounded-[1.5rem] bg-calm-lavender'>
              <img
                src={prog.image}
                alt={prog.imageAlt}
                class='h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]'
                loading='lazy'
                decoding='async'
                width='1100'
                height='880'
              />
              <span class='absolute left-5 top-5 rounded-full bg-brand-white/95 px-3.5 py-1.5 text-[13px] font-semibold text-brand-charcoal'>
                {prog.label}
              </span>
            </div>
            <h3 class='mt-7 font-display text-3xl md:text-[2.4rem] font-semibold leading-tight text-brand-charcoal transition-colors duration-300 group-hover:text-brand-gold-dark'>
              {prog.title}
            </h3>
            <p class='mt-3 max-w-[52ch] text-base leading-relaxed text-brand-charcoal/70'>
              {prog.description}
            </p>
            <span class='mt-6 inline-flex items-center gap-2 text-[15px] font-semibold text-brand-gold-dark'>
              <span>Explore program</span>
              <svg
                class='h-4 w-4 transition-transform duration-300 group-hover:translate-x-1'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
                aria-hidden='true'
              >
                <path stroke-linecap='round' stroke-linejoin='round' d='M17 8l4 4m0 0l-4 4m4-4H3' />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
