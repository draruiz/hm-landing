---
/**
 * Programs & Workshops Section — Featured programs with editorial layout.
 */
const programs = [
  {
    label: "Teen Program",
    title: "Strong Mind Teens",
    description:
      "A specialized program designed to help adolescents build resilience, emotional regulation, and confidence during their most formative years.",
    href: "/programs/strong-mind-teens",
    image: "https://images.unsplash.com/photo-1529543544282-ea669407fca3?w=900&q=80",
    imageAlt: "Teenagers engaged in a supportive group program at Healthy Mind Specialists",
  },
  {
    label: "Community",
    title: "Workshops & Groups",
    description:
      "Interactive workshops and group experiences focused on skill-building, psychoeducation, and community connection.",
    href: "/programs/workshops",
    image: "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=900&q=80",
    imageAlt: "Adults participating in a community wellness workshop and group therapy session",
  },
];
---

<section class='relative bg-brand-white py-24 md:py-36' aria-label='Programs'>
  <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
    <!-- Header -->
    <div class='mb-16 md:mb-24' data-animate>
      <span
        class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-4'
      >
        07 — Programs
      </span>
      <h2
        class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.1] tracking-[-0.01em] max-w-2xl'
      >
        Beyond therapy.<br />Building communities.
      </h2>
    </div>

    <!-- Programs -->
    <div class='grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-10'>
      {
        programs.map((prog) => (
          <div class='group' data-animate>
            <!-- Image with gradient overlay + label chip -->
            <div class='relative h-[280px] md:h-[360px] overflow-hidden mb-8'>
              <img
                src={prog.image}
                alt={prog.imageAlt}
                class='w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105'
                loading='lazy'
                width='900'
                height='360'
              />
              <!-- Gradient: dark at bottom for text legibility -->
              <div class='absolute inset-0 bg-gradient-to-t from-brand-charcoal/80 via-brand-charcoal/10 to-transparent pointer-events-none'></div>
              <!-- Gold accent line on hover -->
              <div class='absolute bottom-0 left-0 h-[3px] bg-brand-gold w-0 group-hover:w-full transition-all duration-500 ease-out'></div>
              <!-- Label overlaid bottom-left -->
              <span class='absolute bottom-5 left-5 font-mono text-[10px] tracking-[0.35em] uppercase text-brand-gold'>
                {prog.label}
              </span>
            </div>

            <h3 class='text-3xl md:text-4xl font-display font-bold text-brand-charcoal mb-4 group-hover:text-brand-gold transition-colors duration-300'>
              {prog.title}
            </h3>
            <div class='w-8 h-px bg-brand-charcoal/15 mb-5' />
            <p class='text-brand-charcoal/50 text-base font-light leading-relaxed mb-8'>
              {prog.description}
            </p>
            <a
              href={prog.href}
              class='group/link inline-flex items-center gap-2 text-base font-semibold tracking-[0.1em] uppercase text-brand-charcoal hover:text-brand-gold transition-colors duration-300'
            >
              <span>Explore program</span>
              <svg
                class='w-4 h-4 transition-transform duration-300 group-hover/link:translate-x-1'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'
              >
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M17 8l4 4m0 0l-4 4m4-4H3'
                />
              </svg>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("is-visible");
      });
    },
    { threshold: 0.1 },
  );
  document
    .querySelectorAll("section[aria-label='Programs'] [data-animate]")
    .forEach((el) => obs.observe(el));
</script>
