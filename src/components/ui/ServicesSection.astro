---
/**
 * Services — sticky intro on the left, full service list on the right.
 * Every description is visible (no hover-only content), so it reads on touch
 * devices and is indexable.
 */
const services = [
  {
    title: "Psychological Evaluations",
    description: "Comprehensive evaluations for ADHD, autism, learning differences, personality functioning, and diagnostic clarification. Designed to provide meaningful answers and practical recommendations.",
    href: "/services/evaluations",
  },
  {
    title: "Anxiety, OCD, Phobias & Related Disorders",
    description: "Specialized treatment for anxiety disorders, OCD, phobias, panic, intrusive thoughts, compulsive behaviors, health anxiety, perfectionism, and chronic stress using evidence-based approaches tailored to your needs.",
    href: "/services/individual-therapy",
  },
  {
    title: "Trauma & EMDR",
    description: "Support for trauma, PTSD, adverse life experiences, and emotional wounds using EMDR and other evidence-based trauma-focused approaches.",
    href: "/services/emdr",
  },
  {
    title: "Child & Adolescent Services",
    description: "Therapy and psychological services designed to support emotional, behavioral, social, academic, and developmental growth.",
    href: "/programs/strong-mind-teens",
  },
  {
    title: "Relationships, Attachment & Personal Growth",
    description: "Support for relationship challenges, breakups, divorces, attachment concerns, self-esteem, communication difficulties, and personal development.",
    href: "/services/individual-therapy",
  },
  {
    title: "Women's Mental Health",
    description: "Support for emotional and psychological challenges associated with hormonal changes, perimenopause, menopause, life transitions, and women's mental health concerns.",
    href: "/services/individual-therapy",
  },
  {
    title: "Coaching & Skills Development",
    description: "Goal-oriented support focused on executive functioning, confidence building, life transitions, accountability, and personal growth.",
    href: "/services/coaching",
  },
  {
    title: "Professional Consultation & Supervision",
    description: "Consultation, supervision, and training services for mental health professionals, students, organizations, and community partners.",
    href: "/services/supervision-and-consultation",
  },
];
---

<section
  id='services'
  class='relative bg-brand-white py-24 md:py-32'
  aria-labelledby='services-title'
>
  <div
    class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16'
  >
    <div class='lg:col-span-5'>
      <div class='lg:sticky lg:top-28'>
        <h2
          id='services-title'
          class='font-display font-semibold text-[2.6rem] sm:text-5xl md:text-6xl leading-[1.04] tracking-[-0.015em] text-brand-charcoal'
        >
          What we<br />
          <em class='italic font-medium text-brand-gold-dark'>can do for you.</em>
        </h2>
        <p class='mt-6 max-w-md text-lg text-brand-charcoal/70 leading-relaxed'>
          Our clinicians bring specialized expertise across a wide range of
          psychological, emotional, behavioral, and developmental concerns
          through psychological evaluations, therapy, coaching, and other mental
          health services for adults, children, and adolescents.
        </p>
        <div class='mt-10 rounded-2xl bg-calm-mist px-6 py-5 max-w-md'>
          <p class='text-[15px] text-brand-charcoal/75'>
            Don't see your concern listed?
          </p>
          <a
            href='/contact'
            class='group mt-1 inline-flex items-center gap-2 text-[15px] font-semibold text-brand-gold-dark hover:text-brand-charcoal transition-colors duration-300'
          >
            <span>Get in Touch</span>
            <svg
              class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              stroke-width='2'
              aria-hidden='true'
            >
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <ul class='lg:col-span-7 border-t border-brand-charcoal/12'>
      {
        services.map((service) => (
          <li>
            <a
              href={service.href}
              class='group grid grid-cols-[1fr_auto] gap-x-6 gap-y-2.5 border-b border-brand-charcoal/12 py-7 md:py-8'
            >
              <h3 class='font-display text-[1.65rem] md:text-[2rem] font-semibold leading-[1.12] text-brand-charcoal transition-colors duration-300 group-hover:text-brand-gold-dark'>
                {service.title}
              </h3>
              <span
                class='mt-1 grid h-11 w-11 place-items-center rounded-full md:row-span-2 border border-brand-charcoal/15 text-brand-charcoal transition-colors duration-300 group-hover:border-brand-gold-dark group-hover:bg-brand-gold-dark group-hover:text-white'
                aria-hidden='true'
              >
                <svg
                  class='h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'
                >
                  <path stroke-linecap='round' stroke-linejoin='round' d='M17 8l4 4m0 0l-4 4m4-4H3' />
                </svg>
              </span>
              <p class='col-span-2 max-w-[60ch] text-base leading-relaxed text-brand-charcoal/70 md:col-span-1'>
                {service.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
