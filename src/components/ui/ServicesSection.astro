---
/**
 * Services Section — Creative agency style: numbered list with hover reveals,
 * asymmetric layout, bold typography. No cards — editorial list approach.
 */
const services = [
  {
    number: "01",
    title: "Psychological Evaluations",
    description: "Comprehensive evaluations for ADHD, autism, learning differences, personality functioning, and diagnostic clarification. Designed to provide meaningful answers and practical recommendations.",
    href: "/services/evaluations",
  },
  {
    number: "02",
    title: "Anxiety, OCD, Phobias & Related Disorders",
    description: "Specialized treatment for anxiety disorders, OCD, phobias, panic, intrusive thoughts, compulsive behaviors, health anxiety, perfectionism, and chronic stress using evidence-based approaches tailored to your needs.",
    href: "/services/individual-therapy",
  },
  {
    number: "03",
    title: "Trauma & EMDR",
    description: "Support for trauma, PTSD, adverse life experiences, and emotional wounds using EMDR and other evidence-based trauma-focused approaches.",
    href: "/services/emdr",
  },
  {
    number: "04",
    title: "Child & Adolescent Services",
    description: "Therapy and psychological services designed to support emotional, behavioral, social, academic, and developmental growth.",
    href: "/programs/strong-mind-teens",
  },
  {
    number: "05",
    title: "Relationships, Attachment & Personal Growth",
    description: "Support for relationship challenges, breakups, divorces, attachment concerns, self-esteem, communication difficulties, and personal development.",
    href: "/services/individual-therapy",
  },
  {
    number: "06",
    title: "Women's Mental Health",
    description: "Support for emotional and psychological challenges associated with hormonal changes, perimenopause, menopause, life transitions, and women's mental health concerns.",
    href: "/services/individual-therapy",
  },
  {
    number: "07",
    title: "Coaching & Skills Development",
    description: "Goal-oriented support focused on executive functioning, confidence building, life transitions, accountability, and personal growth.",
    href: "/services/coaching",
  },
  {
    number: "08",
    title: "Professional Consultation & Supervision",
    description: "Consultation, supervision, and training services for mental health professionals, students, organizations, and community partners.",
    href: "/services/supervision-and-consultation",
  },
];
---

<section id='services' class='relative bg-brand-cream py-24 md:py-36' aria-label='Our Services'>
  <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
    <!-- Section header -->
    <div class='flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16 md:mb-24'>
      <div data-animate>
        <span class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-4'>
          02 — Services
        </span>
        <h2 class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.1] tracking-[-0.01em]'>
          What we<br />can do for you.
        </h2>
      </div>
      <div class='max-w-sm' data-animate>
        <p class='text-brand-charcoal/50 text-base font-light leading-relaxed'>
          Our clinicians bring specialized expertise across a wide range of psychological, emotional, behavioral, and developmental concerns through psychological evaluations, therapy, coaching, and other mental health services for adults, children, and adolescents.
        </p>
      </div>
    </div>

    <!-- Full-bleed image banner between header and list -->
    <div class='relative -mx-6 sm:-mx-10 md:-mx-16 lg:-mx-20 mb-0' data-animate>
      <div class='relative h-[200px] md:h-[320px] overflow-hidden'>
        <img
          src='https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=1600&q=80'
          alt='Compassionate mental health professionals at Healthy Mind Specialists ready to support you'
          class='w-full h-full object-cover object-top'
          loading='lazy'
          width='1600'
          height='320'
        />
        <!-- Dual gradient: cream bleeds in from both sides, concealing edges -->
        <div class='absolute inset-0 bg-gradient-to-r from-brand-cream via-transparent to-brand-cream/80 pointer-events-none'></div>
        <div class='absolute inset-0 bg-gradient-to-b from-brand-cream/60 via-transparent to-brand-cream pointer-events-none'></div>
      </div>
    </div>

    <!-- Services list — editorial, numbered -->
    <div class='border-t border-brand-charcoal/10'>
      {
        services.map((service) => (
          <a
            href={service.href}
            class='service-row group flex flex-col md:flex-row md:items-center gap-4 md:gap-8 py-8 md:py-10 border-b border-brand-charcoal/10 transition-colors duration-300 hover:bg-brand-charcoal/[0.02] -mx-6 px-6 sm:-mx-10 sm:px-10 md:-mx-16 md:px-16 lg:-mx-20 lg:px-20'
            data-animate
          >
            <!-- Number -->
            <span class='font-mono text-[11px] tracking-[0.2em] text-brand-muted md:w-16 flex-shrink-0'>
              {service.number}
            </span>
            <!-- Title -->
            <h3 class='text-3xl md:text-4xl lg:text-5xl font-display font-bold text-brand-charcoal group-hover:text-brand-gold transition-colors duration-300 md:flex-1'>
              {service.title}
            </h3>
            <!-- Description (hidden on mobile, shows on hover line) -->
            <p class='text-base text-brand-charcoal/50 font-light leading-relaxed md:max-w-xs md:text-right md:opacity-0 md:translate-x-4 md:group-hover:opacity-100 md:group-hover:translate-x-0 transition-all duration-500'>
              {service.description}
            </p>
            <!-- Arrow -->
            <svg
              class='hidden md:block w-5 h-5 text-brand-charcoal/20 group-hover:text-brand-gold group-hover:translate-x-1 transition-all duration-300 flex-shrink-0'
              fill='none'
              viewBox='0 0 24 24'
              stroke='currentColor'
              stroke-width='1.5'
            >
              <path stroke-linecap='round' stroke-linejoin='round' d='M17 8l4 4m0 0l-4 4m4-4H3' />
            </svg>
          </a>
        ))
      }
    </div>

    <!-- Don't see your concern? -->
    <div class='mt-12 pt-10 border-t border-brand-charcoal/10' data-animate>
      <p class='text-brand-charcoal/60 text-base font-light mb-3'>
        Don't see your concern listed?
      </p>
      <a
        href='/contact'
        class='group inline-flex items-center gap-2 text-base font-semibold tracking-[0.1em] uppercase text-brand-charcoal hover:text-brand-gold transition-colors duration-300'
      >
        <span>Get in Touch</span>
        <svg
          class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
        >
          <path stroke-linecap='round' stroke-linejoin='round' d='M17 8l4 4m0 0l-4 4m4-4H3' />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("is-visible");
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll("#services [data-animate]").forEach((el) => obs.observe(el));
</script>
