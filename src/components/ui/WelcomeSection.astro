---
/**
 * Welcome Section — Brutalist editorial intro with large typography
 * and asymmetric layout. Agency-grade.
 */
---

<section
  class='relative bg-brand-cream py-24 md:py-36 overflow-hidden'
  aria-label='Welcome'
>
  <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
    <!-- Two-column -->
    <div class='grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20'>
      <!-- Left: Big statement -->
      <div data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.2em] uppercase text-brand-muted block mb-4'
        >
          01 — Welcome
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.1] tracking-[-0.01em]'
        >
          Your mental health<br />
          is not a luxury.<br />
          <em class='not-italic text-brand-gold'>It's the foundation.</em>
        </h2>
      </div>

      <!-- Right: Description -->
      <div class='flex flex-col justify-end' data-animate>
        <div class='w-10 h-px bg-brand-charcoal/15 mb-6'></div>
        <p
          class='text-brand-charcoal/60 text-lg md:text-xl font-light leading-relaxed mb-6'
        >
          Are you constantly stressed and feeling on edge?<br /><br />
          Does it seem like you are losing control and always feeling uncertain of
          what the future holds?<br /><br />
          Are you struggling with intrusive thoughts and the inability to focus?<br
          /><br />
          Have you tried to solve the problems in your life on your own and realized
          you need help from someone else?
        </p>
        <p
          class='text-brand-charcoal text-lg md:text-xl font-medium leading-relaxed mb-8'
        >
          Change begins at the end of your comfort zone.
        </p>
        <a
          href='/about'
          class='group inline-flex items-center gap-2 text-base font-semibold tracking-[0.1em] uppercase text-brand-charcoal hover:text-brand-gold transition-colors duration-300'
        >
          <span>Learn about our approach</span>
          <svg
            class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Editorial image strip: two images + pull quote -->
    <div
      class='mt-16 md:mt-24 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 items-end'
      data-animate
    >
      <!-- Tall image with offset gold frame -->
      <div
        class='md:col-span-5 relative h-[280px] md:h-[400px] overflow-hidden'
      >
        <div
          class='absolute inset-0 translate-x-2.5 translate-y-2.5 border border-brand-gold/35 pointer-events-none z-10'
        >
        </div>
        <img
          src='https://images.unsplash.com/photo-1493836512294-502baa1986e2?w=900&q=80'
          alt='Calm therapy office space designed for meaningful conversations and emotional safety'
          class='w-full h-full object-cover'
          loading='lazy'
          width='900'
          height='400'
        />
      </div>
      <!-- Second image — shifted down on desktop -->
      <div
        class='md:col-span-4 md:mt-14 relative h-[220px] md:h-[300px] overflow-hidden'
      >
        <img
          src='https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?w=700&q=80'
          alt='Parent and child walking together outdoors, representing support for children and adolescents'
          class='w-full h-full object-cover object-center'
          loading='lazy'
          width='700'
          height='300'
        />
        <!-- Thin gold bottom bar -->
        <div class='absolute bottom-0 left-0 right-0 h-[3px] bg-brand-gold/50'>
        </div>
      </div>
      <!-- Pull quote aligned to bottom -->
      <div class='md:col-span-3 flex items-end pb-3 pl-0 md:pl-6'>
        <blockquote class='border-l-2 border-brand-gold/45 pl-5'>
          <p
            class='text-brand-charcoal/60 text-lg md:text-xl font-display font-light italic leading-relaxed'
          >
            "Healing isn't&nbsp;linear. But you don't walk it&nbsp;alone."
          </p>
        </blockquote>
      </div>
    </div>

    <!-- Stats row -->
    <div
      class='mt-20 md:mt-28 grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 border-t border-brand-charcoal/10 pt-12'
      data-animate
    >
      <div>
        <span
          class='block text-4xl md:text-5xl font-display font-semibold text-brand-charcoal tracking-normal'
          >30+</span
        >
        <span
          class='block mt-2 text-xs font-mono tracking-[0.15em] uppercase text-brand-muted'
          >Years of Practice</span
        >
      </div>
      <div>
        <span
          class='block text-4xl md:text-5xl font-display font-semibold text-brand-charcoal tracking-normal'
          >7</span
        >
        <span
          class='block mt-2 text-xs font-mono tracking-[0.15em] uppercase text-brand-muted'
          >Licensed Clinicians</span
        >
      </div>
      <div>
        <span
          class='block text-4xl md:text-5xl font-display font-semibold text-brand-charcoal tracking-normal'
          >All Ages</span
        >
        <span
          class='block mt-2 text-xs font-mono tracking-[0.15em] uppercase text-brand-muted'
          >Children, Teens, Adults</span
        >
      </div>
      <div>
        <span
          class='block text-4xl md:text-5xl font-display font-semibold text-brand-charcoal tracking-normal'
          >1</span
        >
        <span
          class='block mt-2 text-xs font-mono tracking-[0.15em] uppercase text-brand-muted'
          >Tampa Bay Location</span
        >
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
        }
      });
    },
    { threshold: 0.15 },
  );
  document
    .querySelectorAll("[data-animate]")
    .forEach((el) => observer.observe(el));
</script>
