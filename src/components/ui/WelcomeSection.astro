---
/**
 * Welcome — the practice's opening statement and the questions that bring
 * people here. The questions are a scannable list, not a paragraph.
 */
const questions = [
  "Are you constantly stressed and feeling on edge?",
  "Does it seem like you are losing control and always feeling uncertain of what the future holds?",
  "Are you struggling with intrusive thoughts and the inability to focus?",
  "Have you tried to solve the problems in your life on your own and realized you need help from someone else?",
];
---

<section class='relative bg-brand-white py-24 md:py-32' aria-labelledby='welcome-title'>
  <div
    class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20 grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16'
  >
    <div class='lg:col-span-6'>
      <h2
        id='welcome-title'
        class='font-display font-semibold text-[2.6rem] sm:text-5xl md:text-6xl leading-[1.04] tracking-[-0.015em] text-brand-charcoal'
      >
        Your mental health<br />
        is not a luxury.<br />
        <em class='italic font-medium text-brand-gold-dark'>It's the foundation.</em>
      </h2>

      <figure class='mt-12 max-w-md'>
        <svg
          class='w-9 h-9 text-brand-gold'
          viewBox='0 0 32 32'
          fill='currentColor'
          aria-hidden='true'
        >
          <path
            d='M9.3 26c-2.6 0-4.6-.9-5.9-2.6C2.1 21.7 1.5 19.6 1.5 17c0-3.2 1-6 3-8.6 2-2.5 4.8-4.4 8.4-5.6l1 1.9c-2.4 1-4.3 2.3-5.6 3.9-1.3 1.6-1.9 3.2-1.9 4.8 0 .7.2 1.3.5 1.7.4.4 1 .7 1.9.9 1.7.4 2.9 1 3.6 1.8.7.8 1.1 1.8 1.1 3 0 1.4-.5 2.6-1.4 3.4-1 .8-2.2 1.2-3.8 1.2zm16.4 0c-2.6 0-4.6-.9-5.9-2.6-1.3-1.7-1.9-3.8-1.9-6.4 0-3.2 1-6 3-8.6 2-2.5 4.8-4.4 8.4-5.6l1 1.9c-2.4 1-4.3 2.3-5.6 3.9-1.3 1.6-1.9 3.2-1.9 4.8 0 .7.2 1.3.5 1.7.4.4 1 .7 1.9.9 1.7.4 2.9 1 3.6 1.8.7.8 1.1 1.8 1.1 3 0 1.4-.5 2.6-1.4 3.4-1 .8-2.2 1.2-3.8 1.2z'
          ></path>
        </svg>
        <blockquote class='mt-4'>
          <p
            class='font-display italic text-2xl md:text-[1.7rem] leading-snug text-brand-charcoal/80'
          >
            Meaningful change can be difficult, but support can make the journey
            easier.
          </p>
        </blockquote>
      </figure>
    </div>

    <div class='lg:col-span-6 lg:pt-3'>
      <ul class='border-t border-brand-charcoal/12'>
        {
          questions.map((q) => (
            <li class='border-b border-brand-charcoal/12 py-5 md:py-6 text-lg md:text-xl leading-snug text-brand-charcoal/80'>
              {q}
            </li>
          ))
        }
      </ul>

      <p
        class='mt-10 font-display text-[1.9rem] md:text-4xl font-semibold leading-tight text-brand-charcoal text-balance'
      >
        Change begins at the end of your comfort zone.
      </p>

      <a
        href='/about'
        class='group mt-8 inline-flex items-center gap-2 text-[15px] font-semibold text-brand-gold-dark hover:text-brand-charcoal transition-colors duration-300'
      >
        <span>Learn about our approach</span>
        <svg
          class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
          aria-hidden='true'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
        </svg>
      </a>
    </div>
  </div>
</section>
