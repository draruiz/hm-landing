---
// Floating call button — appears on every page, mirrors the WhatsApp-style FAB.
const phoneDisplay = "+1 813-609-2034";
const phoneHref = "tel:+18136092034";
---

<a
  href={phoneHref}
  class='floating-call'
  aria-label={`Call us at ${phoneDisplay}`}
  title={`Call ${phoneDisplay}`}
>
  <svg
    class='floating-call__icon'
    xmlns='http://www.w3.org/2000/svg'
    viewBox='0 0 24 24'
    fill='currentColor'
    aria-hidden='true'
  >
    <path
      d='M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.29 21 3 13.71 3 4.5c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z'
    ></path>
  </svg>
  <span class='floating-call__label'>Call now</span>
</a>

<style>
  .floating-call {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 3.5rem;
    padding: 0 1.1rem;
    border-radius: 9999px;
    background: var(--color-brand-gold, #87ceeb);
    color: var(--color-brand-blue, #0a1931);
    box-shadow: 0 8px 24px rgba(10, 25, 49, 0.28);
    text-decoration: none;
    font-weight: 600;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
    animation: floating-call-pulse 2.4s ease-in-out infinite;
  }

  .floating-call:hover,
  .floating-call:focus-visible {
    background: var(--color-brand-gold-light, #a8ddf5);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(10, 25, 49, 0.34);
    outline: none;
  }

  .floating-call__icon {
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
  }

  .floating-call__label {
    font-size: 0.95rem;
    white-space: nowrap;
  }

  @keyframes floating-call-pulse {
    0%,
    100% {
      box-shadow:
        0 8px 24px rgba(10, 25, 49, 0.28),
        0 0 0 0 rgba(135, 206, 235, 0.5);
    }
    50% {
      box-shadow:
        0 8px 24px rgba(10, 25, 49, 0.28),
        0 0 0 10px rgba(135, 206, 235, 0);
    }
  }

  @media (max-width: 480px) {
    .floating-call {
      bottom: 1rem;
      right: 1rem;
      height: 3.25rem;
      padding: 0 0.85rem;
    }
    .floating-call__label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-call {
      animation: none;
    }
  }
</style>
