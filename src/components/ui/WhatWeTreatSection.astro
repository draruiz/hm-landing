---
/**
 * What We Treat — Two-pane interactive layout.
 * Desktop: hover a condition → sticky preview card crossfades on the right.
 * Mobile: tap a condition → inline detail expands below.
 */
const conditions = [
  {
    name: "Anxiety Disorders",
    detail:
      "Generalized anxiety, social anxiety, panic disorder, and specific phobias — all within our scope of care.",
  },
  {
    name: "Depression",
    detail:
      "Major depressive disorder, persistent depressive disorder, postpartum depression, and seasonal affective disorder.",
  },
  {
    name: "Trauma & PTSD",
    detail:
      "Complex trauma, acute stress reactions, childhood trauma, combat-related PTSD, and relational trauma.",
  },
  {
    name: "ADHD",
    detail:
      "Inattentive, hyperactive-impulsive, and combined presentations — across children, teens, and adults.",
  },
  {
    name: "OCD",
    detail:
      "Obsessions, compulsions, hoarding disorder, and body-focused repetitive behaviors treated with ERP and ACT.",
  },
  {
    name: "Bipolar Disorder",
    detail:
      "Bipolar I & II, cyclothymia, and mood stabilization — coordinated with medical providers when needed.",
  },
  {
    name: "Personality Disorders",
    detail:
      "BPD, narcissistic, avoidant, and other cluster patterns — approached with compassion, DBT, and clear structure.",
  },
  {
    name: "Grief & Loss",
    detail:
      "Bereavement, complicated grief, anticipatory loss, ambiguous loss, and grief after sudden tragedy.",
  },
  {
    name: "Relationship Issues",
    detail:
      "Communication breakdowns, codependency, attachment challenges, infidelity recovery, and family conflict.",
  },
  {
    name: "Substance Use",
    detail:
      "Dual diagnosis support, co-occurring mental health care, recovery maintenance, and harm reduction.",
  },
];
---

<section
  id='what-we-treat'
  class='relative bg-brand-cream py-24 md:py-36 overflow-hidden'
  aria-label='What We Treat'
>
  <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>

    <!-- Header -->
    <div
      class='flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16'
      data-animate
    >
      <div>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-4'
        >
          05 — Conditions
        </span>
        <h2
          class='text-3xl sm:text-4xl md:text-5xl font-display font-semibold text-brand-charcoal leading-[1.1] tracking-[-0.01em]'
        >
          Whatever you're<br />facing — we treat it.
        </h2>
      </div>
      <p class='max-w-sm text-brand-charcoal/50 text-sm font-light leading-relaxed'>
        Our team carries deep expertise across a broad spectrum of mental health
        conditions. If you don't see your concern here, reach out.
      </p>
    </div>

    <!-- Top rule -->
    <div class='h-px bg-brand-charcoal/10 mb-0' data-animate></div>

    <!-- Two-pane layout -->
    <div
      class='grid md:grid-cols-[1fr_290px] lg:grid-cols-[1fr_330px] gap-0 md:gap-10 lg:gap-16 items-start'
      data-animate
    >
      <!-- LEFT: interactive condition list -->
      <div id='wt-list' class='divide-y divide-brand-charcoal/10'>
        {
          conditions.map((cond, i) => (
            <div class='wt-item relative' data-index={i}>
              <button
                class='wt-btn w-full flex items-center gap-4 md:gap-6 py-5 md:py-6 text-left focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-gold/40 rounded-sm'
                data-index={i}
                data-name={cond.name}
                data-detail={cond.detail}
                aria-expanded='false'
                aria-controls={`wt-inline-${i}`}
              >
                <!-- Index number -->
                <span class='wt-num font-mono text-[10px] tracking-[0.25em] w-7 shrink-0'>
                  {String(i + 1).padStart(2, "0")}
                </span>

                <!-- Condition name -->
                <h3 class='wt-name flex-1 text-xl sm:text-2xl md:text-2xl lg:text-[1.55rem] font-display font-semibold leading-tight'>
                  {cond.name}
                </h3>

                <!-- Mobile: chevron -->
                <span class='wt-chevron shrink-0 md:hidden' aria-hidden='true'>
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke='currentColor'
                    stroke-width='2'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M19 9l-7 7-7-7'
                    />
                  </svg>
                </span>

                <!-- Desktop: arrow (shown on active) -->
                <span
                  class='wt-arrow shrink-0 hidden md:block'
                  aria-hidden='true'
                >
                  <svg
                    class='w-4 h-4'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke='currentColor'
                    stroke-width='1.5'
                  >
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M17 8l4 4m0 0l-4 4m4-4H3'
                    />
                  </svg>
                </span>
              </button>

              <!-- Mobile inline detail (hidden on md+) -->
              <div
                id={`wt-inline-${i}`}
                class='wt-inline-detail md:hidden overflow-hidden'
                style='max-height: 0; transition: max-height 0.45s cubic-bezier(0.16,1,0.3,1);'
                role='region'
              >
                <p class='pb-5 pl-11 text-sm text-brand-charcoal/50 leading-relaxed'>
                  {cond.detail}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- RIGHT: sticky preview card (desktop only) -->
      <aside
        class='hidden md:block sticky top-16'
        aria-label='Condition detail'
        aria-live='polite'
        aria-atomic='true'
      >
        <div
          class='relative overflow-hidden bg-brand-white border border-brand-charcoal/12 p-8 lg:p-10'
        >
          <!-- Ghost large number (decorative) -->
          <span
            id='wt-ghost'
            class='absolute -top-3 right-3 font-display font-semibold select-none pointer-events-none leading-none'
            style='font-size: 8rem; color: rgba(42,39,36,0.04);'
            aria-hidden='true'
          >
            01
          </span>

          <!-- Content (fades on switch) -->
          <div id='wt-preview-content'>
            <span
              id='wt-preview-num'
              class='font-mono text-[10px] tracking-[0.35em] text-brand-gold block mb-6'
            >
              01
            </span>
            <h3
              id='wt-preview-name'
              class='text-2xl lg:text-[1.75rem] font-display font-semibold text-brand-charcoal leading-tight mb-4'
            >
              Anxiety Disorders
            </h3>
            <p
              id='wt-preview-detail'
              class='text-sm text-brand-charcoal/50 leading-relaxed'
            >
              Generalized anxiety, social anxiety, panic disorder, and specific
              phobias — all within our scope of care.
            </p>
          </div>

          <!-- Divider + footer -->
          <div class='mt-8 h-px bg-brand-gold/35'></div>
          <p
            class='mt-5 text-[10px] font-mono tracking-[0.22em] uppercase text-brand-muted'
          >
            Evidence-based care
          </p>
        </div>
      </aside>
    </div>

    <!-- Bottom CTA -->
    <div class='mt-12 md:mt-16' data-animate>
      <p class='text-brand-charcoal/40 text-sm font-light mb-4'>
        Don't see your concern listed?
      </p>
      <a
        href='/contact'
        class='group inline-flex items-center gap-2 text-sm font-semibold tracking-[0.1em] uppercase text-brand-charcoal hover:text-brand-gold transition-colors duration-300'
      >
        <span>Get in touch</span>
        <svg
          class='w-4 h-4 transition-transform duration-300 group-hover:translate-x-1'
          fill='none'
          viewBox='0 0 24 24'
          stroke='currentColor'
          stroke-width='2'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  /* ── List item base ── */
  .wt-item {
    position: relative;
    transition: padding-left 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Gold left-border accent */
  .wt-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-brand-gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wt-num {
    color: rgba(140, 136, 128, 0.55);
    transition: color 0.25s ease;
  }
  .wt-name {
    color: rgba(42, 39, 36, 0.42);
    transition: color 0.25s ease;
  }
  .wt-chevron {
    color: rgba(42, 39, 36, 0.28);
    transition:
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.25s ease;
  }
  .wt-arrow {
    color: var(--color-brand-gold);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  /* ── Hover (pointer devices) ── */
  @media (hover: hover) {
    .wt-item:hover .wt-name {
      color: rgba(42, 39, 36, 0.82);
    }
    .wt-item:hover .wt-num {
      color: var(--color-brand-gold);
    }
  }

  /* ── Active state (set by JS) ── */
  .wt-item.is-active::before {
    transform: scaleY(1);
  }
  .wt-item.is-active {
    padding-left: 1rem;
  }
  .wt-item.is-active .wt-num {
    color: var(--color-brand-gold);
  }
  .wt-item.is-active .wt-name {
    color: var(--color-brand-charcoal);
  }
  .wt-item.is-active .wt-arrow {
    opacity: 1;
  }
  /* Mobile: chevron flips when open */
  .wt-item.is-active .wt-chevron {
    transform: rotate(180deg);
    color: var(--color-brand-gold);
  }

  /* ── Preview card crossfade ── */
  #wt-preview-content {
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  @media (max-width: 639px) {
    .wt-item.is-active {
      padding-left: 0.75rem;
    }
  }
</style>

<script>
  // ── Entrance reveal ──
  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("is-visible");
      });
    },
    { threshold: 0.04 },
  );
  document
    .querySelectorAll("#what-we-treat [data-animate]")
    .forEach((el) => revealObs.observe(el));

  // ── Two-pane interaction ──
  const list = document.getElementById("wt-list");

  if (list) {
    const previewContent =
      document.getElementById("wt-preview-content");
    const previewNum = document.getElementById("wt-preview-num");
    const previewName = document.getElementById("wt-preview-name");
    const previewDetail = document.getElementById("wt-preview-detail");
    const ghostNum = document.getElementById("wt-ghost");

    function updatePreview(index: number, name: string, detail: string) {
      if (!previewContent) return;
      const num = String(index + 1).padStart(2, "0");

      // Fade out
      previewContent.style.opacity = "0";
      previewContent.style.transform = "translateY(7px)";

      setTimeout(() => {
        if (previewNum) previewNum.textContent = num;
        if (ghostNum) ghostNum.textContent = num;
        if (previewName) previewName.textContent = name;
        if (previewDetail) previewDetail.textContent = detail;
        // Fade in
        previewContent.style.opacity = "1";
        previewContent.style.transform = "translateY(0)";
      }, 160);
    }

    function setActive(index: number) {
      list
        .querySelectorAll<HTMLElement>(".wt-item")
        .forEach((item) =>
          item.classList.toggle(
            "is-active",
            Number(item.dataset.index) === index,
          ),
        );
    }

    // Init — first item active
    setActive(0);

    list.querySelectorAll<HTMLElement>(".wt-btn").forEach((btn) => {
      const index = Number(btn.dataset.index);
      const name = btn.dataset.name ?? "";
      const detail = btn.dataset.detail ?? "";

      // Desktop: hover updates preview panel
      btn.addEventListener("mouseenter", () => {
        setActive(index);
        updatePreview(index, name, detail);
      });

      // Mobile: click toggles inline detail
      btn.addEventListener("click", () => {
        if (window.innerWidth >= 768) return;

        const inlineDetail = document.getElementById(`wt-inline-${index}`);
        if (!inlineDetail) return;

        const isOpen = btn.getAttribute("aria-expanded") === "true";

        // Close all
        list.querySelectorAll<HTMLElement>(".wt-btn").forEach((b) => {
          b.setAttribute("aria-expanded", "false");
          const d = document.getElementById(
            `wt-inline-${b.dataset.index}`,
          );
          if (d) d.style.maxHeight = "0";
          b.closest<HTMLElement>(".wt-item")?.classList.remove("is-active");
        });

        // Open current
        if (!isOpen) {
          btn.setAttribute("aria-expanded", "true");
          inlineDetail.style.maxHeight = inlineDetail.scrollHeight + "px";
          btn.closest<HTMLElement>(".wt-item")?.classList.add("is-active");
        }
      });
    });
  }
</script>
