---
/**
 * Testing Center — the practice's three evaluation tracks on the one dark
 * band of the page. The H2 names the service people search for.
 */
const tests = [
  {
    title: "Psychological Evaluations",
    description:
      "Our gold-standard battery combines structured clinical interviews, standardized psychometric instruments, and behavioral observation to deliver diagnostic clarity across cognitive, emotional, and personality domains.",
    href: "/services/evaluations",
    features: [
      "Full diagnostic battery",
      "Standardized psychometric instruments",
      "Written clinical report",
      "Personalized feedback session",
    ],
  },
  {
    title: "Online ADHD Evaluations",
    description:
      "A research-informed, fully virtual evaluation protocol developed to identify attention-deficit/hyperactivity disorder across the lifespan. Our tiered assessment model adapts depth to clinical need — from rapid screening to comprehensive documentation.",
    href: "/services/online-adhd-evaluations",
    features: [
      "Telehealth-first protocol",
      "Adult & adolescent populations",
      "Tiered evaluation packages",
      "Documentation for accommodations",
    ],
  },
  {
    title: "Autism Spectrum Evaluation",
    description:
      "Many adults and children go undiagnosed for years because autism often looks different than people expect. Our gold-standard evaluations — using the ADOS-2 and ADI-R — help you finally understand yourself or your child, with actionable insight and a clear path forward.",
    href: "/services/autism-evaluation",
    features: [
      "Adults, teens & children",
      "ADOS-2 & ADI-R protocols",
      "Insurance accepted",
      "Post-evaluation support plan",
    ],
  },
];
---

<section
  id='testing'
  class='relative dark-gradient text-brand-white py-24 md:py-32 overflow-hidden'
  aria-labelledby='testing-title'
>
  <div class='relative max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
    <div class='grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end'>
      <h2
        id='testing-title'
        class='lg:col-span-7 font-display font-semibold text-[2.6rem] sm:text-5xl md:text-6xl leading-[1.04] tracking-[-0.015em] text-balance'
      >
        Psychological testing <em class='italic font-medium text-brand-gold-light'
          >&amp; evaluations</em
        >
      </h2>
      <p class='lg:col-span-5 text-lg text-brand-white/75 leading-relaxed'>
        Every protocol in our Testing Center is grounded in peer-reviewed
        research and validated instruments, and every assessment is conducted by
        licensed doctoral-level psychologists.
      </p>
    </div>

    <ul
      class='mt-16 md:mt-20 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5'
    >
      {
        tests.map((test) => (
          <li>
            <a
              href={test.href}
              class='group flex h-full flex-col rounded-[1.5rem] bg-brand-white/[0.06] p-8 md:p-9 ring-1 ring-inset ring-brand-white/10 transition-colors duration-300 hover:bg-brand-white/[0.1] hover:ring-brand-gold/40'
            >
              <h3 class='font-display text-[1.75rem] md:text-[1.9rem] font-semibold leading-[1.1] text-brand-white'>
                {test.title}
              </h3>

              <p class='mt-5 flex-1 text-[15px] leading-relaxed text-brand-white/70'>
                {test.description}
              </p>

              <ul class='mt-8 space-y-2.5'>
                {test.features.map((feat) => (
                  <li class='flex items-start gap-3 text-[15px] text-brand-white/85'>
                    <svg
                      class='mt-0.5 h-4 w-4 flex-shrink-0 text-brand-gold-light'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke='currentColor'
                      stroke-width='2'
                      aria-hidden='true'
                    >
                      <path stroke-linecap='round' stroke-linejoin='round' d='M4.5 12.75l6 6 9-13.5' />
                    </svg>
                    {feat}
                  </li>
                ))}
              </ul>

              <span class='mt-10 inline-flex items-center gap-2 text-[15px] font-semibold text-brand-gold-light transition-colors duration-300 group-hover:text-brand-white'>
                <span>Explore evaluation</span>
                <svg
                  class='h-4 w-4 transition-transform duration-300 group-hover:translate-x-1'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'
                  aria-hidden='true'
                >
                  <path stroke-linecap='round' stroke-linejoin='round' d='M17 8l4 4m0 0l-4 4m4-4H3' />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
