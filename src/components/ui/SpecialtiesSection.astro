---
/**
 * Specialties Section — Interactive accordion with staggered reveal,
 * gold accent borders, and mobile-first layout.
 */
const specialties = [
  {
    title: "Anxiety & Depression",
    description:
      "Evidence-based CBT, ACT, and mindfulness to quiet the inner critic, break the cycle of worry, and rebuild daily joy.",
  },
  {
    title: "Trauma & PTSD",
    description:
      "EMDR and trauma-focused therapies to safely process painful memories and restore your sense of safety, trust, and wholeness.",
  },
  {
    title: "ADHD & Learning Differences",
    description:
      "Comprehensive evaluations and neurodiversity-affirming strategies to help you understand and leverage your unique cognitive profile.",
  },
  {
    title: "Relationship Challenges",
    description:
      "Individual and couples work to deepen communication, rebuild trust, and cultivate the connection you deserve.",
  },
  {
    title: "Life Transitions",
    description:
      "Grounded support through career pivots, identity shifts, and every pivotal chapter of personal reinvention.",
  },
  {
    title: "Grief & Loss",
    description:
      "A compassionate space to honor all forms of loss — and to find a sustainable, meaning-filled path forward.",
  },
  {
    title: "Self-Esteem & Identity",
    description:
      "Explore who you truly are and build unshakeable self-worth that lets you show up fully in every area of life.",
  },
  {
    title: "Chronic Stress & Burnout",
    description:
      "Somatic tools and deeper healing to restore your energy, establish healthy boundaries, and prevent burnout from returning.",
  },
];
---

<section
  class='relative dark-gradient py-24 md:py-36 overflow-hidden'
  aria-label='Our Specialties'
>
  <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>

    <!-- Header -->
    <div
      class='flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16'
      data-animate
    >
      <div>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-gold block mb-4'
        >
          03 — Specialties
        </span>
        <h2
          class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-white leading-[1.1] tracking-[-0.01em]'
        >
          Areas we<br />specialize in.
        </h2>
      </div>
      <p class='max-w-sm text-brand-white/40 text-base font-light leading-relaxed'>
        Deep expertise across a wide spectrum of mental health challenges —
        every treatment plan tailored to your unique story.
      </p>
    </div>

    <!-- Top rule -->
    <div class='h-px bg-brand-white/10' data-animate></div>

    <!-- Accordion list -->
    <div id='specialties-accordion'>
      {
        specialties.map((item, i) => (
          <div
            class='specialty-item'
            data-animate
            style={`transition-delay: ${i * 55}ms`}
          >
            <button
              class='specialty-btn w-full flex items-center gap-4 md:gap-8 py-5 md:py-7 text-left focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-gold/50 rounded-sm'
              aria-expanded='false'
              aria-controls={`specialty-desc-${i}`}
            >
              <!-- Index -->
              <span class='specialty-num font-mono text-[10px] md:text-[11px] tracking-[0.25em] w-7 md:w-10 shrink-0'>
                0{i + 1}
              </span>

              <!-- Title -->
              <h3 class='specialty-title flex-1 text-2xl sm:text-3xl md:text-4xl lg:text-[2.25rem] font-display font-semibold leading-tight'>>
                {item.title}
              </h3>

              <!-- Toggle icon -->
              <span class='specialty-toggle shrink-0 w-9 h-9 md:w-10 md:h-10 rounded-full border flex items-center justify-center'>
                <svg
                  class='specialty-icon w-3.5 h-3.5 md:w-4 md:h-4'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'
                  aria-hidden='true'
                >
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M12 5v14M5 12h14'
                  />
                </svg>
              </span>
            </button>

            <!-- Expandable description -->
            <div
              id={`specialty-desc-${i}`}
              class='specialty-desc'
              role='region'
            >
              <p class='specialty-desc-text pb-6 md:pb-8 pl-11 md:pl-[4.5rem] text-base md:text-lg leading-relaxed max-w-2xl'>
                {item.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>

  </div>

  <!-- Ghost watermark -->
  <div
    class='absolute right-[-2vw] top-1/2 -translate-y-1/2 pointer-events-none select-none'
    aria-hidden='true'
  >
    <span
      class='font-display font-semibold leading-none'
      style='font-size: clamp(8rem, 20vw, 22rem); color: rgba(246,243,236,0.025);'
    >
      Mind
    </span>
  </div>
</section>

<style>
  /* ── Default state ── */
  .specialty-item {
    position: relative;
    border-bottom: 1px solid rgba(246, 243, 236, 0.1);
    padding-left: 0;
    transition: padding-left 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Gold left-border accent */
  .specialty-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-brand-gold);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .specialty-num {
    color: rgba(196, 151, 90, 0.4);
    transition: color 0.3s ease;
  }
  .specialty-title {
    color: rgba(246, 243, 236, 0.55);
    transition: color 0.3s ease;
  }
  .specialty-toggle {
    border-color: rgba(246, 243, 236, 0.12);
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease;
  }
  .specialty-icon {
    color: rgba(196, 151, 90, 0.5);
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.3s ease;
  }

  /* Collapsed description */
  .specialty-desc {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .specialty-desc-text {
    color: rgba(246, 243, 236, 0.38);
  }

  /* ── Hover (pointer devices only) ── */
  @media (hover: hover) {
    .specialty-item:hover .specialty-title {
      color: rgba(246, 243, 236, 0.85);
    }
    .specialty-item:hover .specialty-num {
      color: rgba(196, 151, 90, 0.7);
    }
  }

  /* ── Open / active state ── */
  .specialty-item[data-open]::before {
    transform: scaleY(1);
  }
  .specialty-item[data-open] {
    padding-left: 1rem;
  }
  .specialty-item[data-open] .specialty-num {
    color: var(--color-brand-gold);
  }
  .specialty-item[data-open] .specialty-title {
    color: var(--color-brand-gold);
  }
  .specialty-item[data-open] .specialty-toggle {
    border-color: rgba(196, 151, 90, 0.5);
    background-color: rgba(196, 151, 90, 0.08);
  }
  .specialty-item[data-open] .specialty-icon {
    transform: rotate(45deg);
    color: var(--color-brand-gold);
  }

  @media (max-width: 640px) {
    .specialty-item[data-open] {
      padding-left: 0.75rem;
    }
  }
</style>

<script>
  // ── Entrance reveal ──
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("is-visible");
      });
    },
    { threshold: 0.04 },
  );
  document
    .querySelectorAll("section[aria-label='Our Specialties'] [data-animate]")
    .forEach((el) => obs.observe(el));

  // ── Accordion ──
  const accordion = document.getElementById("specialties-accordion");
  if (accordion) {
    accordion.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest<HTMLElement>(".specialty-btn");
      if (!btn) return;

      const item = btn.closest<HTMLElement>(".specialty-item")!;
      const desc = item.querySelector<HTMLElement>(".specialty-desc")!;
      const isOpen = item.hasAttribute("data-open");

      // Close all open items
      accordion.querySelectorAll<HTMLElement>(".specialty-item[data-open]").forEach((openItem) => {
        openItem.removeAttribute("data-open");
        openItem.querySelector<HTMLElement>(".specialty-btn")!.setAttribute("aria-expanded", "false");
        openItem.querySelector<HTMLElement>(".specialty-desc")!.style.maxHeight = "0";
      });

      // Open clicked item (unless it was already open)
      if (!isOpen) {
        item.setAttribute("data-open", "");
        btn.setAttribute("aria-expanded", "true");
        desc.style.maxHeight = desc.scrollHeight + "px";
      }
    });
  }
</script>
