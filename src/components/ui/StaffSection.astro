---
/**
 * Team — every clinician visible at once on desktop (4-column grid); on
 * smaller screens a swipeable row with scroll-snap. No auto-scroll, no cloned
 * cards: each profile appears once, as a real link.
 */
const staff = [
  { name: "Dr. Grissel Lloyd", title: "PsyD — Co-Founder", href: "/staff/dr-grissel-m-lloyd-psyd", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/7a46068d-6ad9-4a37-42e0-902c32008200/public" },
  { name: "Dr. Maria Ruiz", title: "PsyD — Co-Founder", href: "/staff/dr-maria-a-ruiz-psyd", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/5f4f545d-05a6-4754-9896-ff4b6cbd9000/public" },
  { name: "Kiyomi Taylor", title: "LMHC — Licensed Therapist", href: "/staff/kiyomi-taylor-lmhc", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/8a32b006-f77d-4ff5-13ad-9a4c2158eb00/public" },
  { name: "Chloe Johnson", title: "LMHC — Licensed Therapist", href: "/staff/chloe-johnson-lmhc", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/ca480842-0849-4ea3-bd0f-403dd430ad00/public" },
  { name: "Steven Borrero", title: "LMHC — Licensed Therapist", href: "/staff/steven-borrero-lmhc", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/9c9bf0a3-cf2f-4e59-78a3-c3838652b800/public" },
  { name: "Florencia Lapadula", title: "LMHC — Licensed Therapist", href: "/staff/florencia-lapadula-lmhc", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/41d1d55e-e99e-4c5f-d929-4ea646536000/public" },
  { name: "Edward Porter", title: "LCSW — Licensed Clinical SW", href: "/staff/edward-porter-lcsw", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/4d62b896-9a42-4628-4cff-d32dfb4bca00/public" },
  { name: "Morgan Adams", title: "Mindfulness Specialist & Life Coach", href: "/staff/morgan-adams-msw", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/b13d28c3-98c3-4dbd-7ba7-d16aefbad700/public" },
  { name: "Dr. Asia Wardlaw", title: "PsyD — Licensed Psychologist", href: "/staff/dr-asia-wardlaw-psyd", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/6e817f35-0729-4415-e9cc-106de5df9400/public" },
  { name: "Dr. Sonia Javani", title: "PsyD — Licensed Psychologist", href: "/staff/dr-sonia-javani-psyd", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/37569d14-63fe-4060-0043-9e9c1baaed00/public" },
  { name: "Traci Adams", title: "CLC — Life Coach", href: "/staff/traci-adams-clc", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/96c2a220-7c97-4a54-5bed-de73b398c600/public" },
  { name: "Terika Brewer", title: "MA — Clinical Associate", href: "/staff/terika-brewer-ma", image: "https://imagedelivery.net/B5r6pMfQRTYBHyjgaDFr8w/59e6bfdb-7439-4ca4-89a9-1eeccb23ad00/public" },
];
---

<section
  id='team'
  class='relative bg-brand-cream py-24 md:py-32 overflow-hidden'
  aria-labelledby='team-title'
>
  <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
    <div class='grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-16 items-end'>
      <h2
        id='team-title'
        class='lg:col-span-6 font-display font-semibold text-[2.6rem] sm:text-5xl md:text-6xl leading-[1.04] tracking-[-0.015em] text-brand-charcoal'
      >
        The people behind<br />
        <em class='italic font-medium text-brand-gold-dark'>the practice.</em>
      </h2>
      <p class='lg:col-span-6 text-lg text-brand-charcoal/70 leading-relaxed'>
        Our team includes licensed psychologists, therapists, counselors, and coaching professionals with diverse clinical backgrounds and specialized expertise in psychological assessment, trauma, anxiety, OCD, child and adolescent mental health, relationship concerns, and other areas of emotional and psychological wellbeing.
      </p>
    </div>

    <ul
      class='no-scrollbar mt-14 md:mt-16 -mx-6 sm:-mx-10 md:-mx-16 flex snap-x snap-mandatory scroll-px-6 sm:scroll-px-10 md:scroll-px-16 gap-5 overflow-x-auto px-6 sm:px-10 md:px-16 pb-2 lg:mx-0 lg:grid lg:grid-cols-4 lg:gap-x-6 lg:gap-y-12 lg:overflow-visible lg:px-0'
      aria-label='Clinicians and staff'
    >
      {
        staff.map((member) => (
          <li class='w-[72%] flex-shrink-0 snap-start sm:w-[44%] md:w-[31%] lg:w-auto'>
            <a href={member.href} class='group block'>
              <div class='aspect-[4/5] overflow-hidden rounded-[1.25rem] bg-calm-lavender'>
                <img
                  src={member.image}
                  alt={`${member.name}, ${member.title}`}
                  width='320'
                  height='400'
                  class='h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.04]'
                  loading='lazy'
                  decoding='async'
                />
              </div>
              <h3 class='mt-4 font-display text-[1.45rem] font-semibold leading-tight text-brand-charcoal transition-colors duration-300 group-hover:text-brand-gold-dark'>
                {member.name}
              </h3>
              <p class='mt-1 text-[14px] text-brand-charcoal/65'>
                {member.title}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
