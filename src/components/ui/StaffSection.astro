---

<section id='team' class='relative bg-brand-cream py-24 md:py-36 overflow-hidden' aria-label='Our Team'>
  <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
    <!-- Header -->
    <div class='flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16 md:mb-20'>
      <div data-animate>
        <span class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-muted block mb-4'>
          08 — Team
        </span>
        <h2 class='text-4xl sm:text-5xl md:text-6xl font-display font-semibold text-brand-charcoal leading-[1.1] tracking-[-0.01em]'>
          The people behind<br />the practice.
        </h2>
      </div>
      <div class='max-w-sm' data-animate>
        <p class='text-brand-charcoal/50 text-base font-light leading-relaxed'>
          Our team includes licensed psychologists, therapists, counselors, and coaching professionals with diverse clinical backgrounds and specialized expertise in psychological assessment, trauma, anxiety, OCD, child and adolescent mental health, relationship concerns, and other areas of emotional and psychological wellbeing.
        </p>
      </div>
    </div>
  </div>

  <!-- Horizontal carousel (mobile + desktop) -->
  <div class='relative' data-animate>
    <button
      id='team-prev'
      type='button'
      class='hidden md:flex absolute left-4 lg:left-8 top-[38%] -translate-y-1/2 z-20 w-11 h-11 items-center justify-center rounded-full bg-brand-white/90 text-brand-charcoal border border-brand-charcoal/10 shadow-sm hover:bg-brand-white transition-colors duration-300'
      aria-label='Scroll team left'
    >
      <svg class='w-5 h-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'>
        <path stroke-linecap='round' stroke-linejoin='round' d='M15 19l-7-7 7-7' />
      </svg>
    </button>

    <button
      id='team-next'
      type='button'
      class='hidden md:flex absolute right-4 lg:right-8 top-[38%] -translate-y-1/2 z-20 w-11 h-11 items-center justify-center rounded-full bg-brand-white/90 text-brand-charcoal border border-brand-charcoal/10 shadow-sm hover:bg-brand-white transition-colors duration-300'
      aria-label='Scroll team right'
    >
      <svg class='w-5 h-5' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2'>
        <path stroke-linecap='round' stroke-linejoin='round' d='M9 5l7 7-7 7' />
      </svg>
    </button>

    <div id='team-scroll' class='staff-scroll overflow-x-auto pb-6 scrollbar-hide scroll-smooth' data-animate>
      <div class='flex gap-4 md:gap-6 px-6 sm:px-10 md:px-16 lg:px-20 w-max'>
      {
        staff.map((member, i) => (
          <a
            href={member.href}
            class='group flex-shrink-0 w-64 md:w-72 snap-start'
          >
            <!-- Photo card -->
            <div class='relative aspect-[3/4] bg-brand-blue overflow-hidden mb-4'>
              <img
                src={member.image}
                alt={`${member.name} — ${member.title}`}
                width='288'
                height='384'
                class='absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105'
                loading='lazy'
                decoding='async'
              />
              <!-- Bottom gradient overlay for text legibility -->
              <div class='absolute inset-0 bg-gradient-to-t from-brand-blue/70 via-brand-blue/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500' />
              <!-- Number badge -->
              <span class='absolute top-4 left-4 font-mono text-[10px] tracking-[0.2em] text-brand-white/50 bg-brand-blue/40 backdrop-blur-sm px-2 py-1'>
                {String(i + 1).padStart(2, "0")}
              </span>
              <!-- Hover name overlay -->
              <div class='absolute bottom-0 left-0 right-0 p-5 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500'>
                <span class='font-mono text-[10px] tracking-[0.15em] uppercase text-brand-gold'>
                  View profile →
                </span>
              </div>
            </div>
            <h3 class='text-lg font-display font-bold text-brand-charcoal group-hover:text-brand-gold transition-colors duration-300'>
              {member.name}
            </h3>
            <p class='text-sm font-mono tracking-[0.05em] text-brand-muted mt-1'>
              {member.title}
            </p>
          </a>
        ))
      }
      </div>
    </div>
  </div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
    user-select: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("is-visible");
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll("#team [data-animate]").forEach((el) => obs.observe(el));

  const teamScroll = document.getElementById("team-scroll");
  const prevBtn = document.getElementById("team-prev");
  const nextBtn = document.getElementById("team-next");

  if (teamScroll) {
    const scrollAmount = 360;
    let isPaused = false;
    let isMouseDown = false;
    let startX = 0;
    let scrollLeftStart = 0;
    let touchStartX = 0;
    let touchScrollStart = 0;
    let resumeTimer: ReturnType<typeof setTimeout> | null = null;
    let seamPoint = 0; // scroll-content position where clones begin

    // ── Infinite clone setup ─────────────────────────────────────────────
    const track = teamScroll.querySelector(":scope > div") as HTMLElement | null;
    if (track) {
      const originals = Array.from(track.children);
      originals.forEach((item) => {
        const clone = (item as HTMLElement).cloneNode(true) as HTMLElement;
        clone.setAttribute("aria-hidden", "true");
        clone.setAttribute("tabindex", "-1");
        track.appendChild(clone);
      });

      // Measure after two rAFs so layout is guaranteed to be complete
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          const firstClone = track.children[originals.length] as HTMLElement;
          if (firstClone) {
            const scrollerRect = teamScroll.getBoundingClientRect();
            const cloneRect = firstClone.getBoundingClientRect();
            seamPoint =
              cloneRect.left - scrollerRect.left + teamScroll.scrollLeft;
          }
        })
      );
    }

    const pause = () => {
      isPaused = true;
      if (resumeTimer) { clearTimeout(resumeTimer); resumeTimer = null; }
    };

    const resume = (delay = 0) => {
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => { isPaused = false; }, delay);
    };

    // Instant scroll helper — bypasses any smooth-scroll CSS
    const jumpTo = (left: number) => {
      teamScroll.style.scrollBehavior = "auto";
      teamScroll.scrollLeft = left;
      teamScroll.style.scrollBehavior = "";
    };

    // ── Auto-scroll (infinite) ───────────────────────────────────────────
    setInterval(() => {
      if (isPaused || isMouseDown) return;
      if (seamPoint > 0 && teamScroll.scrollLeft >= seamPoint) {
        // Seamless forward loop: subtract exactly one set of items
        jumpTo(teamScroll.scrollLeft - seamPoint);
      } else {
        teamScroll.scrollBy({ left: 1, behavior: "auto" });
      }
    }, 20);

    // Backward loop guard: if user drags/swipes back to the very start, wrap to end of first set
    teamScroll.addEventListener(
      "scroll",
      () => {
        if (seamPoint > 0 && teamScroll.scrollLeft < 1) {
          jumpTo(seamPoint);
        }
      },
      { passive: true }
    );

    // Prev / next buttons
    prevBtn?.addEventListener("click", () => {
      pause();
      teamScroll.scrollBy({ left: -scrollAmount, behavior: "smooth" });
      resume(1500);
    });

    nextBtn?.addEventListener("click", () => {
      pause();
      teamScroll.scrollBy({ left: scrollAmount, behavior: "smooth" });
      resume(1500);
    });

    // Desktop wheel → horizontal scroll
    teamScroll.addEventListener(
      "wheel",
      (event) => {
        if (window.innerWidth < 768) return;
        if (!(teamScroll.scrollWidth > teamScroll.clientWidth)) return;
        event.preventDefault();
        pause();
        teamScroll.scrollBy({ left: event.deltaY, behavior: "auto" });
        resume(1500);
      },
      { passive: false }
    );

    // Hover pause (desktop)
    teamScroll.addEventListener("mouseenter", () => { if (!isMouseDown) pause(); });
    teamScroll.addEventListener("mouseleave", () => { if (!isMouseDown) resume(500); });

    // Mouse drag (desktop)
    teamScroll.style.cursor = "grab";

    teamScroll.addEventListener("mousedown", (e) => {
      isMouseDown = true;
      isPaused = true;
      startX = e.pageX - teamScroll.offsetLeft;
      scrollLeftStart = teamScroll.scrollLeft;
      teamScroll.style.cursor = "grabbing";
    });

    document.addEventListener("mousemove", (e) => {
      if (!isMouseDown) return;
      const x = e.pageX - teamScroll.offsetLeft;
      teamScroll.scrollLeft = scrollLeftStart - (x - startX) * 1.5;
    });

    document.addEventListener("mouseup", () => {
      if (!isMouseDown) return;
      isMouseDown = false;
      teamScroll.style.cursor = "grab";
      resume(1500);
    });

    // Touch swipe (mobile)
    teamScroll.addEventListener("touchstart", (e) => {
      pause();
      touchStartX = e.touches[0].pageX;
      touchScrollStart = teamScroll.scrollLeft;
    }, { passive: true });

    teamScroll.addEventListener("touchmove", (e) => {
      teamScroll.scrollLeft = touchScrollStart + (touchStartX - e.touches[0].pageX);
    }, { passive: true });

    teamScroll.addEventListener("touchend", () => {
      resume(2000);
    }, { passive: true });
  }
</script>
