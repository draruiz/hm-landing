---
/**
 * Research / Approach Section — Dark immersive panel with methodology highlights.
 * Clean, confident, no canvas animations. Pure CSS for performance.
 */
const methods = [
  {
    title: "Evidence-Based",
    description:
      "Every treatment we offer is grounded in peer-reviewed research and clinical best practices.",
  },
  {
    title: "Culturally Responsive",
    description:
      "We honor the diverse identities and lived experiences of every client we serve.",
  },
  {
    title: "Trauma-Informed",
    description:
      "Safety, choice, and collaboration are at the core of everything we do.",
  },
  {
    title: "Outcome-Driven",
    description:
      "We track progress and adjust treatment to ensure you are moving toward your goals.",
  },
];
---

<section
  class='relative bg-brand-blue py-24 md:py-36 overflow-hidden'
  aria-label='Our Approach'
>
  <div class='max-w-7xl mx-auto px-6 sm:px-10 md:px-16 lg:px-20'>
    <!-- Header -->
    <div
      class='grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 mb-16 md:mb-24'
    >
      <div data-animate>
        <span
          class='font-mono text-[11px] tracking-[0.3em] uppercase text-brand-gold block mb-4'
        >
          06 — Approach
        </span>
        <h2
          class='text-3xl sm:text-4xl md:text-5xl font-display font-semibold text-brand-white leading-[1.1] tracking-[-0.01em]'
        >
          Science meets<br />compassion.
        </h2>
      </div>
      <div class='flex flex-col justify-end' data-animate>
        <p class='text-brand-white/40 text-base font-light leading-relaxed'>
          We integrate the latest psychological research with genuine human
          connection. Our approach isn't just about treating symptoms — it's
          about understanding you as a whole person and supporting lasting
          change.
        </p>
      </div>
    </div>

    <!-- Pull-quote image break -->
    <div
      class='relative -mx-6 sm:-mx-10 md:-mx-16 lg:-mx-20 mb-16 md:mb-20'
      data-animate
    >
      <div class='relative h-[240px] md:h-[360px] overflow-hidden'>
        <img
          src='https://images.unsplash.com/photo-1582213782179-e0d53f98f2ca?w=1600&q=80'
          alt='Diverse group therapy session in a safe, welcoming environment'
          class='w-full h-full object-cover object-center'
          loading='lazy'
          width='1600'
          height='360'
        />
        <!-- Navy overlay for brand cohesion -->
        <div class='absolute inset-0 bg-brand-blue/65 pointer-events-none'>
        </div>
        <!-- Centered italic pull quote -->
        <div
          class='absolute inset-0 flex items-center justify-center px-6 sm:px-12 text-center'
        >
          <blockquote>
            <p
              class='text-2xl md:text-3xl lg:text-4xl font-display font-light text-brand-white/90 italic leading-snug max-w-3xl'
            >
              "We don't just treat symptoms —<br class='hidden md:block' /> we treat&nbsp;people."
            </p>
          </blockquote>
        </div>
        <!-- Thin gold rule — bottom edge -->
        <div class='absolute bottom-0 left-0 right-0 h-[2px] bg-brand-gold/40'>
        </div>
      </div>
    </div>

    <!-- Methods grid -->
    <div
      class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-brand-white/10'
      data-animate
    >
      {
        methods.map((method, i) => (
          <div class='bg-brand-blue p-8 md:p-10 group hover:bg-brand-blue-light transition-colors duration-500'>
            <span class='font-mono text-[10px] tracking-[0.2em] text-brand-gold/50 block mb-6'>
              0{i + 1}
            </span>
            <h3 class='text-lg font-display font-bold text-brand-white mb-3'>
              {method.title}
            </h3>
            <p class='text-sm text-brand-white/40 font-light leading-relaxed'>
              {method.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Subtle grid lines -->
  <div class='absolute inset-0 pointer-events-none' aria-hidden='true'>
    <div class='absolute left-[25%] top-0 bottom-0 w-px bg-brand-white/[0.02]'>
    </div>
    <div class='absolute left-[50%] top-0 bottom-0 w-px bg-brand-white/[0.02]'>
    </div>
    <div class='absolute left-[75%] top-0 bottom-0 w-px bg-brand-white/[0.02]'>
    </div>
  </div>
</section>

<script>
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) e.target.classList.add("is-visible");
      });
    },
    { threshold: 0.1 },
  );
  document
    .querySelectorAll("section[aria-label='Our Approach'] [data-animate]")
    .forEach((el) => obs.observe(el));
</script>
